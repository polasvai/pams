@page
@using POMS.Web.Areas.Identity.Pages.Account
@model LoginModel
@{
    ViewData["Title"] = "Sign in";
}
<section class="auth-card"><div class="auth-brand"><span class="brand-mark">CA</span><span>Cricket Auction <b>Manager</b></span></div><span class="eyebrow">Operator access</span><h1>Welcome back.</h1><p class="text-muted">Sign in to open the auction dashboard and manage your workspace.</p><form method="post" class="auth-form">@Html.AntiForgeryToken()<input type="hidden" asp-for="ReturnUrl" /><div asp-validation-summary="ModelOnly" class="text-danger"></div><label class="form-label" asp-for="Input.Email"></label><input asp-for="Input.Email" class="form-control form-control-lg" autocomplete="username" /><span asp-validation-for="Input.Email" class="text-danger"></span><label class="form-label" asp-for="Input.Password"></label><input asp-for="Input.Password" class="form-control form-control-lg" autocomplete="current-password" /><span asp-validation-for="Input.Password" class="text-danger"></span><div class="d-flex justify-content-between align-items-center small"><label class="form-check"><input asp-for="Input.RememberMe" class="form-check-input" /> Remember me</label><a asp-page="./ForgotPassword">Forgot password?</a></div><button class="btn btn-primary btn-lg w-100 mt-3" type="submit">Sign in to dashboard</button></form><p class="auth-switch">New to the workspace? <a asp-page="./Register">Create an account</a></p></section>
