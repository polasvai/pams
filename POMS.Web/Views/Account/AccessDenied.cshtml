@{
    ViewData["Title"] = "Access Denied";
}

<div class="row justify-content-center py-5">
    <div class="col-md-6 text-center">
        <div class="display-1 text-danger mb-3">⛔</div>
        <h1 class="h2 font-weight-bold mb-2">Access Denied</h1>
        <p class="text-muted mb-4">You do not have permission to view this resource. Please sign in with an administrator account.</p>
        <div class="d-flex justify-content-center gap-2">
            <a class="btn btn-primary" asp-controller="Account" asp-action="Login">Sign In as Admin</a>
            <a class="btn btn-outline-secondary" asp-controller="Home" asp-action="Index">Back to Home</a>
        </div>
    </div>
</div>
