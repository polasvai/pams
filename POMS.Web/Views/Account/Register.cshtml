@model POMS.Web.Models.RegisterViewModel
@{
    ViewData["Title"] = "Create Operator Account";
}

<div class="auth-wrapper d-flex align-items-center justify-content-center min-vh-100 py-5">
    <div class="auth-card p-4 p-md-5 rounded-4 shadow-lg border-0 bg-white" style="max-width: 480px; width: 100%;">
        <div class="text-center mb-4">
            <div class="d-inline-flex align-items-center justify-content-center bg-primary text-white rounded-3 p-3 mb-3 shadow-sm">
                <span class="fs-2">🏏</span>
            </div>
            <h1 class="h3 font-weight-bold text-dark mb-1">Create Operator Account</h1>
            <p class="text-muted small">Register to participate in auctions and manage team rosters</p>
        </div>

        <form asp-controller="Account" asp-action="Register" method="post" id="registerForm">
            <input type="hidden" asp-for="ReturnUrl" />
            
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small mb-3" role="alert"></div>

            <div class="mb-3">
                <label class="form-label font-weight-bold small text-dark" asp-for="Username">Username</label>
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0">👤</span>
                    <input asp-for="Username" class="form-control border-start-0" placeholder="e.g. jsmith" autocomplete="username" required autofocus />
                </div>
                <span asp-validation-for="Username" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label class="form-label font-weight-bold small text-dark" asp-for="Email">Email Address</label>
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0">📧</span>
                    <input asp-for="Email" class="form-control border-start-0" placeholder="operator@poms.local" autocomplete="email" required />
                </div>
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label class="form-label font-weight-bold small text-dark" asp-for="DisplayName">Display Name (Optional)</label>
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0">🏷️</span>
                    <input asp-for="DisplayName" class="form-control border-start-0" placeholder="John Smith" />
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label font-weight-bold small text-dark" asp-for="Password">Password</label>
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0">🔒</span>
                    <input asp-for="Password" class="form-control border-start-0" placeholder="Create a password (min 4 chars)" autocomplete="new-password" required />
                </div>
                <span asp-validation-for="Password" class="text-danger small"></span>
            </div>

            <div class="mb-4">
                <label class="form-label font-weight-bold small text-dark" asp-for="ConfirmPassword">Confirm Password</label>
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0">🔒</span>
                    <input asp-for="ConfirmPassword" class="form-control border-start-0" placeholder="Confirm password" autocomplete="new-password" required />
                </div>
                <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
            </div>

            <button class="btn btn-primary btn-lg w-100 font-weight-bold py-2 shadow-sm" type="submit">
                Create Account ↗
            </button>
        </form>

        <div class="text-center mt-4 pt-3 border-top">
            <span class="small text-muted">Already registered?</span>
            <a asp-controller="Account" asp-action="Login" class="small font-weight-bold text-primary ms-1">Sign In</a>
            <div class="mt-2">
                <a asp-controller="Home" asp-action="Index" class="small text-muted text-decoration-none">← Back to Home</a>
            </div>
        </div>
    </div>
</div>
