@model Team
@{ ViewData["Title"] = "Edit Team - " + Model.Name; }

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="d-flex align-items-center justify-content-between mb-4">
            <div>
                <span class="eyebrow">Franchise Setup</span>
                <h1 class="h2 font-weight-bold mb-0">Edit Team Profile</h1>
            </div>
            <a class="btn btn-outline-secondary btn-sm" asp-action="Index">← Back to Teams</a>
        </div>

        <div class="card p-4 p-md-5 border-0 shadow-sm rounded-4">
            <form asp-action="Edit" method="post">
                <input asp-for="Id" type="hidden" />
                <div asp-validation-summary="All" class="alert alert-danger py-2 small" role="alert"></div>

                <div class="row g-4">
                    <div class="col-md-8">
                        <label class="form-label font-weight-bold" asp-for="Name">Team Name</label>
                        <input asp-for="Name" class="form-control form-control-lg" required />
                    </div>

                    <div class="col-md-4">
                        <label class="form-label font-weight-bold" asp-for="ShortCode">Short Code</label>
                        <input asp-for="ShortCode" class="form-control form-control-lg text-uppercase" maxlength="10" required />
                    </div>

                    <div class="col-12">
                        <label class="form-label font-weight-bold" asp-for="TotalBudget">Total Purse Budget (৳)</label>
                        <input asp-for="TotalBudget" type="number" step="100000" min="0" class="form-control form-control-lg" required />
                    </div>

                    <div class="col-12">
                        <label class="form-label font-weight-bold" asp-for="LogoUrl">Logo URL</label>
                        <input asp-for="LogoUrl" class="form-control" />
                    </div>
                </div>

                <hr class="my-4" />

                <div class="d-flex justify-content-end gap-2">
                    <a class="btn btn-light" asp-action="Index">Cancel</a>
                    <button class="btn btn-primary px-4 font-weight-bold" type="submit">Save Changes</button>
                </div>
            </form>
        </div>
    </div>
</div>
