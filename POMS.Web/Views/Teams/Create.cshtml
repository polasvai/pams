@model Team
@{ ViewData["Title"] = "Add team"; }
<div class="card p-4"><h1 class="h3 mb-3">Add team</h1><form asp-action="Create" method="post"><div asp-validation-summary="All" class="text-danger"></div><div class="row g-3"><div class="col-md-6"><label class="form-label">Team name</label><input asp-for="Name" class="form-control" /></div><div class="col-md-3"><label class="form-label">Short code</label><input asp-for="ShortCode" class="form-control" maxlength="10" /></div><div class="col-md-3"><label class="form-label">Total purse</label><input asp-for="TotalBudget" class="form-control" /></div><div class="col-12"><label class="form-label">Logo URL</label><input asp-for="LogoUrl" class="form-control" /></div></div><div class="mt-4"><button class="btn btn-primary">Save team</button> <a class="btn btn-link" asp-action="Index">Cancel</a></div></form></div>
