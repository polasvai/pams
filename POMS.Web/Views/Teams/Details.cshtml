@model Team
@{ ViewData["Title"] = Model.Name; }
<div class="page-heading d-flex flex-wrap justify-content-between align-items-end gap-3"><div><span class="eyebrow">Team profile</span><h1 class="h3 mb-1">@Model.Name <span class="badge bg-primary">@Model.ShortCode</span></h1><p class="text-muted mb-0">Public squad and auction purse.</p></div><div class="d-flex gap-2"><a class="btn btn-outline-secondary" asp-action="Index">Back to teams</a>@if (User.Identity?.IsAuthenticated == true) { <a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.Id">Edit team</a> }</div></div>
<div class="row g-4"><div class="col-md-4"><div class="card p-4"><div class="text-muted">Total purse</div><div class="h3">₹@Model.TotalBudget.ToString("N0")</div></div></div><div class="col-md-8"><div class="card p-4"><h2 class="h5">Acquired players</h2>@if (Model.AuctionPlayers.Any()) { <div class="table-responsive"><table class="table align-middle"><thead><tr><th>Player</th><th>Auction</th><th>Price</th></tr></thead><tbody>@foreach (var lot in Model.AuctionPlayers) { <tr><td>@(lot.Player?.FullName ?? "Unknown player")</td><td>@(lot.Auction?.Name ?? "Unknown auction")</td><td>₹@(lot.SoldPrice?.ToString("N0") ?? "-")</td></tr> }</tbody></table></div> } else { <p class="text-muted mb-0">No players acquired yet.</p> }</div></div></div>
