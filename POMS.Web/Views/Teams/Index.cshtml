@model IEnumerable<Team>
@{ ViewData["Title"] = "Teams"; }
<div class="page-heading d-flex flex-wrap justify-content-between align-items-end gap-3"><div><span class="eyebrow">Squad room</span><h1 class="h3 mb-1">Teams</h1><p class="text-muted mb-0">Public team directory and auction purses.</p></div>@if (User.Identity?.IsAuthenticated == true) { <a class="btn btn-primary" asp-action="Create">Add team</a> } else { <a class="btn btn-primary" asp-area="Identity" asp-page="/Account/Login" asp-route-returnUrl="/Teams">Sign in to manage</a> }</div>
@if (TempData["Success"] is string success) { <div class="alert alert-success">@success</div> }
<div class="row g-3">@foreach (var team in Model) { <div class="col-md-6 col-lg-4"><div class="card team-card p-4 h-100"><div class="d-flex justify-content-between align-items-start"><div class="d-flex gap-3 align-items-center"><div class="team-initial">@team.ShortCode[..1]</div><div><h2 class="h5 mb-1">@team.Name</h2><span class="text-muted small">@(team.AuctionPlayers.Count) acquired players</span></div></div><span class="team-code">@team.ShortCode</span></div><div class="purse"><span>Total purse</span><strong>₹@team.TotalBudget.ToString("N0")</strong></div><div class="d-flex gap-2 mt-3"><a class="btn btn-sm btn-primary flex-grow-1" asp-action="Details" asp-route-id="@team.Id">View squad</a>@if (User.Identity?.IsAuthenticated == true) { <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@team.Id">Edit</a> }</div></div></div> }</div>
