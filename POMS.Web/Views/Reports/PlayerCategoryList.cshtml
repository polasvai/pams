@model POMS.Web.Models.PlayerCategoryListViewModel
@{
    ViewData["Title"] = "Player Category List";
    var settings = Model.Settings;
}

<div class="container-fluid py-4">
    <!-- Non-printable Toolbar -->
    <div class="d-print-none card p-3 shadow-sm mb-4 border-0 rounded-3">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
            <div>
                <span class="eyebrow text-primary">Reports & Analytics</span>
                <h1 class="h3 font-weight-bold mb-0">Player Category List</h1>
                <small class="text-muted">Total Players: <strong>@Model.TotalPlayers</strong> across @Model.CategoryGroups.Count categories</small>
            </div>
            <div class="d-flex flex-wrap gap-2">
                <a class="btn btn-outline-secondary" asp-controller="Home" asp-action="Index">← Home</a>
                <a class="btn btn-success fw-bold d-flex align-items-center gap-1" asp-action="ExportPlayerCategoryExcel">
                    <span>📊</span> Export to Excel
                </a>
                <button type="button" class="btn btn-danger fw-bold d-flex align-items-center gap-1" id="btnExportPdf" onclick="exportToPdf()">
                    <span>📥</span> Export to PDF
                </button>
                <button type="button" class="btn btn-primary fw-bold d-flex align-items-center gap-1" onclick="window.print()">
                    <span>🖨️</span> Print Report
                </button>
            </div>
        </div>
    </div>

    <!-- Printable Report Container -->
    <div id="reportContainer" class="report-sheet bg-white p-4 shadow-sm mx-auto">
        <!-- Top Logo & Title Box -->
        <div class="text-center mb-3">
            @if (!string.IsNullOrEmpty(settings.LogoUrl))
            {
                <div class="mb-2">
                    <img src="@settings.LogoUrl" alt="Logo" class="report-logo" style="max-height: 70px; object-fit: contain;" />
                </div>
            }
            <div class="report-title-box">
                BCL Player List 2026, Session 14
            </div>
        </div>

        <!-- Category Tables -->
        <div class="table-responsive">
            <table class="report-table w-100">
                @foreach (var group in Model.CategoryGroups)
                {
                    <!-- Category Header -->
                    <thead>
                        <tr class="category-header-row">
                            <th colspan="9" class="category-header-cell">
                                @group.DisplayTitle
                            </th>
                        </tr>
                        <tr class="column-header-row">
                            <th style="width: 3%;">SL</th>
                            <th style="width: 4%;">Reg. No</th>
                            <th style="width: 10%;">Image</th>
                            <th style="width: 21%;">Player Name</th>
                            <th style="width: 11%;">Role</th>
                            <th style="width: 10%;">Batting</th>
                            <th style="width: 10%;">Bowling</th>
                            <th style="width: 13%;">Mobile</th>
                            <th style="width: 18%;">Current Team</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (group.Players.Count > 0)
                        {
                            int sl = 1;
                            @foreach (var item in group.Players)
                            {
                                var player = item.Player;
                                var currentTeam = item.CurrentTeam;
                                <tr>
                                    <td class="text-center font-monospace sl-cell">@sl</td>
                                    <td class="text-center font-monospace regi-cell">@player.Id</td>
                                    <td class="text-center py-1">
                                        @if (!string.IsNullOrEmpty(player.ProfilePictureUrl))
                                        {
                                            <img src="@player.ProfilePictureUrl" alt="@player.FullName" class="player-photo" />
                                        }
                                        else
                                        {
                                            <div class="photo-placeholder">👤</div>
                                        }
                                    </td>
                                    <td class="text-start px-1 fw-semibold player-name-cell">@player.FullName</td>
                                    <td class="text-center">@player.Role</td>
                                    <td class="text-center">@(string.IsNullOrEmpty(player.BattingStyle) ? "-" : player.BattingStyle)</td>
                                    <td class="text-center">@(string.IsNullOrEmpty(player.BowlingStyle) ? "-" : player.BowlingStyle)</td>
                                    <td class="text-center font-monospace mobile-cell">@(string.IsNullOrEmpty(player.MobileNumber) ? "-" : player.MobileNumber)</td>
                                    <td class="text-center team-cell px-1">
                                        @if (currentTeam != null)
                                        {
                                            <div class="team-badge">
                                                <span class="team-name">@currentTeam.Name</span>
                                                @if (!string.IsNullOrEmpty(currentTeam.ShortCode))
                                                {
                                                    <span class="team-code">(@currentTeam.ShortCode)</span>
                                                }
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="unsold-text">Unsold</span>
                                        }
                                    </td>
                                </tr>
                                sl++;
                            }
                        }
                        else
                        {
                            <!-- Blank template rows if no players in category -->
                            for (int i = 1; i <= 3; i++)
                            {
                                <tr class="empty-row">
                                    <td class="text-center">@i</td>
                                    <td></td>
                                    <td></td>
                                    <td></td>
                                    <td></td>
                                    <td></td>
                                    <td></td>
                                    <td></td>
                                    <td></td>
                                </tr>
                            }
                        }
                        <!-- Spacer between categories -->
                        <tr class="category-spacer-row">
                            <td colspan="9" style="border: none; height: 16px;"></td>
                        </tr>
                    </tbody>
                }
            </table>
        </div>
    </div>
</div>

<style>
    /* Official Report Styling matching reference sheet */
    .report-sheet {
        max-width: 900px;
        background: #fff;
        border: 1px solid #dee2e6;
        font-family: Arial, "Helvetica Neue", Helvetica, sans-serif;
    }

    .report-title-box {
        display: inline-block;
        border: 2px solid #000;
        padding: 6px 28px;
        font-size: 1.05rem;
        font-weight: bold;
        color: #000;
        letter-spacing: 0.5px;
        background-color: #fff;
    }

    .report-table {
        border-collapse: collapse;
        border: 2px solid #000;
        font-size: 0.76rem;
        color: #000;
        background: #fff;
        table-layout: fixed;
    }

    .report-table th,
    .report-table td {
        border: 1px solid #000;
        padding: 4px 3px;
        vertical-align: middle;
        overflow-wrap: break-word;
        word-break: normal;
    }

    .category-header-row th {
        background-color: #f7f7f7;
        font-size: 0.88rem;
        font-weight: bold;
        text-align: center;
        padding: 6px;
        border: 1px solid #000;
        border-top: 2px solid #000;
    }

    .column-header-row th {
        background-color: #fff;
        font-weight: bold;
        text-align: center;
        padding: 5px 2px;
        border: 1px solid #000;
        font-size: 0.74rem;
    }

    .player-photo {
        width: 100%;
        height: 65px;
        object-fit: cover;
        border-radius: 3px;
        border: 1px solid #888;
        display: inline-block;
    }

    .photo-placeholder {
        width: 100%;
        height: 65px;
        line-height: 30px;
        text-align: center;
        background: #eee;
        border-radius: 3px;
        display: inline-block;
        font-size: 16px;
    }

    .sl-cell, .regi-cell {
        padding: 4px 1px !important;
        font-size: 0.72rem;
        white-space: nowrap;
    }

    .player-name-cell {
        font-size: 0.80rem;
        line-height: 1.25;
        padding-left: 5px !important;
        padding-right: 5px !important;
    }

    .mobile-cell {
        font-size: 0.70rem;
    }

    .empty-row td {
        height: 28px;
    }

    /* Current Team badge styling with text wrapping */
    .team-cell {
        word-break: normal;
        overflow-wrap: break-word;
        white-space: normal !important;
        vertical-align: middle;
        line-height: 1.15;
    }

    .team-badge {
        display: inline-block;
        padding: 2px 4px;
        background-color: #e8f5e9;
        border: 1px solid #81c784;
        border-radius: 3px;
        color: #1b5e20;
        font-size: 0.70rem;
        font-weight: 700;
        max-width: 100%;
        box-sizing: border-box;
    }

    .team-name {
        display: block;
        line-height: 1.15;
    }

    .team-code {
        display: block;
        font-size: 0.65rem;
        color: #2e7d32;
        font-weight: 600;
        margin-top: 1px;
    }

    .unsold-text {
        display: inline-block;
        padding: 2px 5px;
        background-color: #f5f5f5;
        border: 1px solid #d6d6d6;
        border-radius: 3px;
        color: #757575;
        font-size: 0.70rem;
    }

    /* Print media optimization */
    @@media print {
        body {
            background: #fff !important;
            font-size: 9pt !important;
        }

        .site-nav,
        footer,
        .d-print-none {
            display: none !important;
        }

        .report-sheet {
            box-shadow: none !important;
            border: none !important;
            padding: 0 !important;
            max-width: 100% !important;
            width: 100% !important;
        }

        .report-table {
            width: 100% !important;
        }

        thead {
            display: table-header-group;
        }

        tr {
            page-break-inside: avoid;
        }

        @@page {
            size: A4 portrait;
            margin: 6mm 5mm;
        }
    }
</style>

@section Scripts {
    <script src="~/js/html2pdf.bundle.min.js"></script>
    <script>
        function exportToPdf() {
            const btn = document.getElementById('btnExportPdf');
            const originalText = btn.innerHTML;
            btn.innerHTML = '<span>⏳</span> Generating PDF...';
            btn.disabled = true;

            const element = document.getElementById('reportContainer');
            const opt = {
                margin: [5, 5, 5, 5],
                filename: 'BCL_Player_Category_List_2026.pdf',
                image: { type: 'jpeg', quality: 0.98 },
                html2canvas: { scale: 2, useCORS: true, logging: false },
                jsPDF: { unit: 'mm', format: 'a4', orientation: 'portrait' },
                pagebreak: { mode: ['css', 'legacy'] }
            };

            html2pdf().set(opt).from(element).save().then(() => {
                btn.innerHTML = originalText;
                btn.disabled = false;
            }).catch(err => {
                console.error(err);
                btn.innerHTML = originalText;
                btn.disabled = false;
                alert('Could not export to PDF. Please try Print Report instead.');
            });
        }
    </script>
}
