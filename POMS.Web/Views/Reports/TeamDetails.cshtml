@model POMS.Web.Models.TeamDetailsReportViewModel
@{
    ViewData["Title"] = "Team Details Report";
    var settings = Model.Settings;
    var selectedTeam = Model.SelectedTeam;
}

<div class="container-fluid py-4">
    <!-- Non-printable Toolbar with Team Selection -->
    <div class="d-print-none card p-4 shadow-sm mb-4 border-0 rounded-4">
        <div class="row align-items-center g-3">
            <div class="col-lg-5">
                <span class="eyebrow text-primary">Reports & Analytics</span>
                <h1 class="h3 font-weight-bold mb-1">Team Details Report</h1>
                <p class="text-muted small mb-0">Select a team to view and export the roster with jersey numbers and player details.</p>
            </div>
            
            <div class="col-lg-4">
                <form method="get" asp-action="TeamDetails" id="teamForm">
                    <label class="form-label font-weight-bold small text-uppercase text-muted">Select Team Name First</label>
                    <select name="teamId" id="teamSelect" class="form-select form-select-lg shadow-sm border-primary" onchange="document.getElementById('teamForm').submit()">
                        <option value="">-- Select Team Name --</option>
                        <!option value="-1" @(Model.IsAllTeams ? "selected" : "") class="fw-bold text-primary">
                            🌟 ALL Teams (Complete Roster)
                        </!option>
                        @foreach (var team in Model.AllTeams)
                        {
                            <!option value="@team.Id" @(Model.SelectedTeamId == team.Id && !Model.IsAllTeams ? "selected" : "")>
                                @team.Name (@team.ShortCode)
                            </!option>
                        }
                    </select>
                </form>
            </div>

            <div class="col-lg-3 text-lg-end">
                @if (selectedTeam != null || Model.IsAllTeams)
                {
                    <div class="d-flex flex-wrap gap-2 justify-content-lg-end">
                        <a class="btn btn-success fw-bold d-flex align-items-center gap-1" asp-action="ExportTeamDetailsExcel" asp-route-teamId="@(Model.IsAllTeams ? -1 : selectedTeam!.Id)">
                            <span>📊</span> Excel
                        </a>
                        <button type="button" class="btn btn-danger fw-bold d-flex align-items-center gap-1" id="btnExportPdf" onclick="exportToPdf()">
                            <span>📥</span> PDF
                        </button>
                        <button type="button" class="btn btn-primary fw-bold d-flex align-items-center gap-1" onclick="window.print()">
                            <span>🖨️</span> Print
                        </button>
                    </div>
                }
            </div>
        </div>

        @if (selectedTeam == null && !Model.IsAllTeams)
        {
            <hr class="my-4" />
            <div>
                <h6 class="font-weight-bold text-muted mb-3">Or quick select a report option below:</h6>
                <div class="row g-2">
                    <div class="col-md-3 col-sm-6">
                        <a class="btn btn-primary w-100 text-truncate text-start py-2 fw-bold" asp-action="TeamDetails" asp-route-teamId="-1">
                            🌟 <strong>ALL Teams</strong> <small class="opacity-75">(Combined PDF)</small>
                        </a>
                    </div>
                    @foreach (var team in Model.AllTeams)
                    {
                        <div class="col-md-3 col-sm-6">
                            <a class="btn btn-outline-primary w-100 text-truncate text-start py-2" asp-action="TeamDetails" asp-route-teamId="@team.Id">
                                🛡️ <strong>@team.Name</strong> <small class="text-muted">(@team.ShortCode)</small>
                            </a>
                        </div>
                    }
                </div>
            </div>
        }
    </div>

    <!-- Printable Report Container -->
    @if (selectedTeam != null || Model.IsAllTeams)
    {
        <div id="reportContainer" class="report-sheet bg-white p-4 shadow-sm mx-auto">
            <!-- Top Logo & Title Box -->
            <div class="text-center mb-3">
                @if (!string.IsNullOrEmpty(settings.LogoUrl))
                {
                    <div class="mb-2">
                        <img src="@settings.LogoUrl" alt="Logo" class="report-logo" style="max-height: 70px; object-fit: contain;" />
                    </div>
                }
                <div class="report-title-box">
                    @(Model.IsAllTeams ? "BCL All Teams Player List 2026, Session 14" : "BCL Team Player List 2026, Session 14")
                </div>
            </div>

            @if (Model.IsAllTeams)
            {
                <!-- ALL Teams Rendering: Sequential team rosters with page breaks -->
                var teamIndex = 0;
                foreach (var group in Model.AllTeamGroups)
                {
                    var team = group.Team;
                    var players = group.Players;
                    teamIndex++;

                    <div class="team-report-block @(teamIndex > 1 ? "page-break-before mt-4" : "")">
                        <div class="table-responsive">
                            <table class="report-table w-100">
                                <thead>
                                    <!-- Team Name Header Row -->
                                    <tr class="team-header-row">
                                        <th colspan="12" class="team-header-cell">
                                            @team.Name (@team.ShortCode)
                                        </th>
                                    </tr>
                                    <!-- Column Headers: SL | Reg. No | Image | Player Name | Role | Batting | Bowling | Mobile | Jersey Name | Size | No | Note -->
                                    <tr class="column-header-row">
                                        <th style="width: 4%;">SL</th>
                                        <th style="width: 6%;">Reg. No</th>
                                        <th style="width: 9%;">Image</th>
                                        <th style="width: 17%;">Player Name</th>
                                        <th style="width: 10%;">Role</th>
                                        <th style="width: 9%;">Batting</th>
                                        <th style="width: 9%;">Bowling</th>
                                        <th style="width: 12%;">Mobile</th>
                                        <th style="width: 9%;">Jersey</th>
                                        <th style="width: 5%;">Size</th>
                                        <th style="width: 4%;">No.</th>
                                        <th style="width: 6%;">Note</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (players.Count > 0)
                                    {
                                        int sl = 1;
                                        @foreach (var item in players)
                                        {
                                            var player = item.Player;
                                            var auctionName = item.Auction?.Name;
                                            <tr>
                                                <td class="text-center">@sl</td>
                                                <td class="text-center font-monospace">@player.Id</td>
                                                <td class="text-center py-1">
                                                    @if (!string.IsNullOrEmpty(player.ProfilePictureUrl))
                                                    {
                                                        <img src="@player.ProfilePictureUrl" alt="@player.FullName" class="player-photo" />
                                                    }
                                                    else
                                                    {
                                                        <div class="photo-placeholder">👤</div>
                                                    }
                                                </td>
                                                <td class="text-start px-2 fw-semibold">@player.FullName</td>
                                                <td class="text-center">@player.Role</td>
                                                <td class="text-center">@(string.IsNullOrEmpty(player.BattingStyle) ? "-" : player.BattingStyle)</td>
                                                <td class="text-center">@(string.IsNullOrEmpty(player.BowlingStyle) ? "-" : player.BowlingStyle)</td>
                                                <td class="text-center font-monospace">@(string.IsNullOrEmpty(player.MobileNumber) ? "-" : player.MobileNumber)</td>
                                                <td class="text-center">@(string.IsNullOrEmpty(player.JerseyName) ? "-" : player.JerseyName)</td>
                                                <td class="text-center">@(string.IsNullOrEmpty(player.JerseySize) ? "-" : player.JerseySize)</td>
                                                <td class="text-center font-monospace">@(string.IsNullOrEmpty(player.JerseyNumber) ? "-" : player.JerseyNumber)</td>
                                                <td class="text-center small">
                                                    @(string.IsNullOrEmpty(auctionName) ? "" : auctionName)
                                                </td>
                                            </tr>
                                            sl++;
                                        }
                                    }
                                    else
                                    {
                                        <tr>
                                            <td colspan="12" class="text-center py-4 text-muted bg-light">
                                                <em>No player found in this team yet.</em>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                }
            }
            else if (selectedTeam != null)
            {
                <!-- Single Team Player Table -->
                <div class="table-responsive">
                    <table class="report-table w-100">
                        <thead>
                            <!-- Team Name Header Row -->
                            <tr class="team-header-row">
                                <th colspan="12" class="team-header-cell">
                                    @selectedTeam.Name
                                </th>
                            </tr>
                            <!-- Column Headers: SL | Reg. No | Image | Player Name | Role | Batting | Bowling | Mobile | Jersey Name | Size | No | Note -->
                            <tr class="column-header-row">
                                <th style="width: 4%;">SL</th>
                                <th style="width: 6%;">Reg. No</th>
                                <th style="width: 9%;">Image</th>
                                <th style="width: 17%;">Player Name</th>
                                <th style="width: 10%;">Role</th>
                                <th style="width: 9%;">Batting</th>
                                <th style="width: 9%;">Bowling</th>
                                <th style="width: 12%;">Mobile</th>
                                <th style="width: 9%;">Jersey</th>
                                <th style="width: 5%;">Size</th>
                                <th style="width: 4%;">No.</th>
                                <th style="width: 6%;">Note</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.TeamPlayers.Count > 0)
                            {
                                int sl = 1;
                                @foreach (var item in Model.TeamPlayers)
                                {
                                    var player = item.Player;
                                    var auctionName = item.Auction?.Name;
                                    <tr>
                                        <td class="text-center">@sl</td>
                                        <td class="text-center font-monospace">@player.Id</td>
                                        <td class="text-center py-1">
                                            @if (!string.IsNullOrEmpty(player.ProfilePictureUrl))
                                            {
                                                <img src="@player.ProfilePictureUrl" alt="@player.FullName" class="player-photo" />
                                            }
                                            else
                                            {
                                                <div class="photo-placeholder">👤</div>
                                            }
                                        </td>
                                        <td class="text-start px-2 fw-semibold">@player.FullName</td>
                                        <td class="text-center">@player.Role</td>
                                        <td class="text-center">@(string.IsNullOrEmpty(player.BattingStyle) ? "-" : player.BattingStyle)</td>
                                        <td class="text-center">@(string.IsNullOrEmpty(player.BowlingStyle) ? "-" : player.BowlingStyle)</td>
                                        <td class="text-center font-monospace">@(string.IsNullOrEmpty(player.MobileNumber) ? "-" : player.MobileNumber)</td>
                                        <td class="text-center">@(string.IsNullOrEmpty(player.JerseyName) ? "-" : player.JerseyName)</td>
                                        <td class="text-center">@(string.IsNullOrEmpty(player.JerseySize) ? "-" : player.JerseySize)</td>
                                        <td class="text-center font-monospace">@(string.IsNullOrEmpty(player.JerseyNumber) ? "-" : player.JerseyNumber)</td>
                                        <td class="text-center small">
                                        @*    @(string.IsNullOrEmpty(auctionName) ? "" : auctionName)     *@
                                        </td>
                                    </tr>
                                    sl++;
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="12" class="text-center py-4 text-muted bg-light">
                                        <div class="py-2">
                                            <span class="fs-4 d-block mb-1">🏏</span>
                                            <strong class="text-dark">No player found</strong>
                                            <p class="small text-muted mb-0">No players have been acquired by @selectedTeam.Name in any auction yet.</p>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                @if (Model.TeamPlayers.Count == 0)
                {
                    <div class="d-print-none alert alert-warning border mt-3 small text-center">
                        ℹ️ <strong>No player found</strong> for @selectedTeam.Name. When players are acquired in an auction, they will be listed here along with the auction name.
                    </div>
                }
            }
        </div>
    }
</div>

<style>
    /* Official Report Styling matching reference sheet */
    .report-sheet {
        max-width: 900px;
        background: #fff;
        border: 1px solid #dee2e6;
        font-family: Arial, "Helvetica Neue", Helvetica, sans-serif;
    }

    .report-title-box {
        display: inline-block;
        border: 2px solid #000;
        padding: 6px 28px;
        font-size: 1.05rem;
        font-weight: bold;
        color: #000;
        letter-spacing: 0.5px;
        background-color: #fff;
    }

    .report-table {
        border-collapse: collapse;
        border: 2px solid #000;
        font-size: 0.72rem;
        color: #000;
        background: #fff;
        table-layout: fixed;
    }

    .report-table th,
    .report-table td {
        border: 1px solid #000;
        padding: 4px 2px;
        vertical-align: middle;
        overflow-wrap: break-word;
        word-break: normal;
    }

    .team-header-row th {
        background-color: #f7f7f7;
        font-size: 0.92rem;
        font-weight: bold;
        text-align: center;
        padding: 6px;
        border: 1px solid #000;
        border-top: 2px solid #000;
    }

    .column-header-row th {
        background-color: #fff;
        font-weight: bold;
        text-align: center;
        padding: 4px 2px;
        border: 1px solid #000;
        font-size: 0.70rem;
    }

    .player-photo {
        width: 100%;
        height: 60px;
        object-fit: cover;
        border-radius: 3px;
        border: 1px solid #888;
        display: inline-block;
    }

    .photo-placeholder {
        width: 100%;
        height: 60px;
        line-height: 28px;
        text-align: center;
        background: #eee;
        border-radius: 3px;
        display: inline-block;
        font-size: 14px;
    }

    .empty-row td {
        height: 28px;
    }

    /* Print media optimization */
    @@media print {
        body {
            background: #fff !important;
            font-size: 9pt !important;
        }

        .site-nav,
        footer,
        .d-print-none {
            display: none !important;
        }

        .report-sheet {
            box-shadow: none !important;
            border: none !important;
            padding: 0 !important;
            max-width: 100% !important;
            width: 100% !important;
        }

        .report-table {
            width: 100% !important;
        }

        thead {
            display: table-header-group;
        }

        tr {
            page-break-inside: avoid;
        }

        .page-break-before {
            page-break-before: always;
            break-before: page;
        }

        @@page {
            size: A4 portrait;
            margin: 6mm 5mm;
        }
    }
</style>

@if (selectedTeam != null || Model.IsAllTeams)
{
    var pdfFileName = Model.IsAllTeams 
        ? "BCL_All_Teams_Player_List_2026.pdf" 
        : $"BCL_Team_Details_{(selectedTeam?.ShortCode ?? "Team")}_2026.pdf";

    @section Scripts {
        <script src="~/js/html2pdf.bundle.min.js"></script>
        <script>
            function exportToPdf() {
                const btn = document.getElementById('btnExportPdf');
                const originalText = btn.innerHTML;
                btn.innerHTML = '<span>⏳</span> Generating PDF...';
                btn.disabled = true;

                const element = document.getElementById('reportContainer');
                const opt = {
                    margin: [5, 5, 5, 5],
                    filename: '@pdfFileName',
                    image: { type: 'jpeg', quality: 0.98 },
                    html2canvas: { scale: 2, useCORS: true, logging: false },
                    jsPDF: { unit: 'mm', format: 'a4', orientation: 'portrait' },
                    pagebreak: { mode: ['css', 'legacy'] }
                };

                html2pdf().set(opt).from(element).save().then(() => {
                    btn.innerHTML = originalText;
                    btn.disabled = false;
                }).catch(err => {
                    console.error(err);
                    btn.innerHTML = originalText;
                    btn.disabled = false;
                    alert('Could not export to PDF. Please try Print Report instead.');
                });
            }
        </script>
    }
}
