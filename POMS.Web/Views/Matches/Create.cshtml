@model POMS.Data.Models.Match
@{ ViewData["Title"] = "Schedule Match"; }

<div class="row justify-content-center py-4">
    <div class="col-lg-8">
        <div class="d-flex align-items-center justify-content-between mb-4">
            <div>
                <span class="eyebrow text-primary">Tournament Fixtures</span>
                <h1 class="h2 font-weight-bold mb-0">Schedule Match</h1>
            </div>
            <a class="btn btn-outline-secondary btn-sm" asp-action="Index">← Back to Schedule</a>
        </div>

        <div class="card p-4 shadow-sm border-0">
            <form asp-action="Create" method="post">
                <div asp-validation-summary="All" class="alert alert-danger py-2 small" role="alert"></div>

                <div class="row g-4">
                    <div class="col-md-6">
                        <label class="form-label font-weight-bold" asp-for="Team1Id">Home Team</label>
                        <select asp-for="Team1Id" asp-items="ViewBag.Teams" class="form-select form-select-lg" required>
                            <option value="">-- Select Team --</option>
                        </select>
                        <span asp-validation-for="Team1Id" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label font-weight-bold" asp-for="Team2Id">Away Team</label>
                        <select asp-for="Team2Id" asp-items="ViewBag.Teams" class="form-select form-select-lg" required>
                            <option value="">-- Select Team --</option>
                        </select>
                        <span asp-validation-for="Team2Id" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label font-weight-bold" asp-for="MatchDate">Match Date & Time</label>
                        <input asp-for="MatchDate" type="datetime-local" class="form-control form-control-lg" required />
                        <span asp-validation-for="MatchDate" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label font-weight-bold" asp-for="Venue">Venue / Stadium</label>
                        <input asp-for="Venue" class="form-control form-control-lg" placeholder="e.g. Sher-e-Bangla Stadium" />
                        <span asp-validation-for="Venue" class="text-danger small"></span>
                    </div>
                </div>

                <hr class="my-4" />
                <div class="d-flex justify-content-end gap-2">
                    <a class="btn btn-light" asp-action="Index">Cancel</a>
                    <button class="btn btn-primary px-4 font-weight-bold" type="submit">Schedule Match</button>
                </div>
            </form>
        </div>
    </div>
</div>
