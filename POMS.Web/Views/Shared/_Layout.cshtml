<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Cricket Player Auction Management System - Professional workspace for managing team budgets, player pools, and live auction consoles." />
    <title>@ViewData["Title"] · Cricket Auction Manager</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/matchday.css" asp-append-version="true" />
</head>
@inject POMS.Web.Services.SettingsService SettingsSvc
@{
    var settings = SettingsSvc.GetSettings();
    var currentPath = Context.Request.Path.Value ?? "/";
    var isAuthPage = currentPath.StartsWith("/Account", StringComparison.OrdinalIgnoreCase) || currentPath.StartsWith("/Identity/Account", StringComparison.OrdinalIgnoreCase);
    var isLandingPage = currentPath == "/";
}
<body class="@(isAuthPage ? "auth-page" : "app-body")">

@if (isAuthPage)
{
    <main class="auth-shell">
        @RenderBody()
    </main>
}
else
{
    <!-- Unified Main Header Navigation -->
    <header class="site-nav navbar navbar-expand-lg sticky-top">
        <div class="container-fluid px-lg-4">
            <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                @if (!string.IsNullOrEmpty(settings.LogoUrl))
                {
                    <img src="@settings.LogoUrl" alt="Logo" height="30" class="me-2" />
                }
                else
                {
                    <span class="brand-mark">CA</span>
                }
                <span><b>@settings.SiteName</b></span>
            </a>
            
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            
            <div class="collapse navbar-collapse" id="mainNav">
                <ul class="navbar-nav me-auto ms-lg-4 align-items-lg-center gap-1">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <li class="nav-item">
                            <a class="nav-link @(currentPath.StartsWith("/Dashboard", StringComparison.OrdinalIgnoreCase) ? "active" : "")" asp-controller="Dashboard" asp-action="Index">
                                📊 Dashboard
                            </a>
                        </li>
                    }
                    <li class="nav-item">
                        <a class="nav-link @(currentPath.StartsWith("/Players", StringComparison.OrdinalIgnoreCase) && !currentPath.Contains("/Register") ? "active" : "")" asp-controller="Players" asp-action="Index">
                            🏏 Players
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link fw-bold text-primary @(currentPath.StartsWith("/Players/Register", StringComparison.OrdinalIgnoreCase) ? "active" : "")" asp-controller="Players" asp-action="Register">
                            📝 Player Registration
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(currentPath.StartsWith("/Teams", StringComparison.OrdinalIgnoreCase) ? "active" : "")" asp-controller="Teams" asp-action="Index">
                            🛡️ Teams
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(currentPath.StartsWith("/Auctions", StringComparison.OrdinalIgnoreCase) && !currentPath.Contains("/Live") ? "active" : "")" asp-controller="Auctions" asp-action="Index">
                            📋 Auctions
                        </a>
                    </li>
                    @if (User.IsInRole("Admin") || User.IsInRole("SuperAdmin"))
                    {
                        <li class="nav-item">
                            <a class="nav-link @(currentPath.StartsWith("/Settings", StringComparison.OrdinalIgnoreCase) ? "active" : "")" asp-controller="Settings" asp-action="Index">
                                ⚙️ Settings
                            </a>
                        </li>
                    }
                </ul>

                <div class="d-flex align-items-center gap-3 mt-3 mt-lg-0">
                    <a class="btn btn-warning nav-cta d-flex align-items-center gap-2 fw-bold" asp-controller="Auctions" asp-action="Live">
                        <span class="live-dot animate-pulse"></span> Live Console
                    </a>
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </div>
    </header>

    <main class="main-content">
        @if (!isLandingPage)
        {
            <div class="page-shell">
                @RenderBody()
            </div>
        }
        else
        {
            @RenderBody()
        }
    </main>

    <footer class="site-footer mt-auto pt-5 pb-3 bg-white text-dark border-top shadow-sm">
        <div class="container-fluid px-lg-5">
            <div class="row g-4 mb-4">
                <!-- Brand & About -->
                <div class="col-lg-4 col-md-6">
                    <div class="d-flex align-items-center mb-3">
                        @if (!string.IsNullOrEmpty(settings.LogoUrl))
                        {
                            <img src="@settings.LogoUrl" alt="Logo" height="40" class="me-2" />
                        }
                        else
                        {
                            <span class="brand-mark me-2">CA</span>
                        }
                        <h4 class="mb-0 fw-bold text-dark">@settings.SiteName</h4>
                    </div>
                    <p class="text-muted small pe-lg-4">
                        A professional command center for managing cricket player auctions, team purses, and real-time live bidding seamlessly.
                    </p>
                </div>

                <!-- Quick Links -->
                <div class="col-lg-4 col-md-6">
                    <h5 class="fw-bold mb-3 text-dark">Quick Links</h5>
                    <ul class="list-unstyled mb-0 d-flex flex-column gap-2">
                        <li><a asp-controller="Home" asp-action="Index" class="text-muted text-decoration-none slide-hover">Home</a></li>
                        <li><a asp-controller="Players" asp-action="Index" class="text-muted text-decoration-none slide-hover">Player Talent Pool</a></li>
                        <li><a asp-controller="Teams" asp-action="Index" class="text-muted text-decoration-none slide-hover">Franchise Teams</a></li>
                        <li><a asp-controller="Auctions" asp-action="Index" class="text-muted text-decoration-none slide-hover">Live Auctions</a></li>
                        <li><a asp-controller="Players" asp-action="Register" class="text-primary text-decoration-none fw-bold slide-hover">📝 Register as Player</a></li>
                    </ul>
                </div>

                <!-- Contact -->
                <div class="col-lg-4 col-md-6">
                    <h5 class="fw-bold mb-3 text-dark">Contact Us</h5>
                    <ul class="list-unstyled text-muted small d-flex flex-column gap-3 mb-0">
                        <li class="d-flex align-items-start gap-2">
                            <span class="text-primary">📍</span>
                            <span>@settings.FooterAddress</span>
                        </li>
                        <li class="d-flex align-items-center gap-2">
                            <span class="text-primary">📧</span>
                            <a href="mailto:@settings.ContactEmail" class="text-muted text-decoration-none">@settings.ContactEmail</a>
                        </li>
                        <li class="d-flex align-items-center gap-2">
                            <span class="text-primary">📞</span>
                            <a href="tel:@settings.ContactPhone" class="text-muted text-decoration-none">@settings.ContactPhone</a>
                        </li>
                    </ul>
                </div>
            </div>
            
            <hr class="border-secondary opacity-25 mb-3" />
            
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-center gap-2 text-muted small">
                <div>
                    &copy; @DateTime.Now.Year <strong class="text-dark">@settings.SiteName</strong>. All rights reserved.
                </div>
                <div>
                    Made with ❤️ <a href="https://srpolas.github.io/profile/" target="_blank" class="text-decoration-none fw-bold">S.R Polas</a>
                </div>
            </div>
        </div>
    </footer>
}

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
