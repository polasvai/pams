<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Cricket Player Auction Management System - Professional workspace for managing team budgets, player pools, and live auction consoles." />
    <title>@ViewData["Title"] · Cricket Auction Manager</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/matchday.css" asp-append-version="true" />
</head>
@{
    var currentPath = Context.Request.Path.Value ?? "/";
    var isAuthPage = currentPath.StartsWith("/Account", StringComparison.OrdinalIgnoreCase) || currentPath.StartsWith("/Identity/Account", StringComparison.OrdinalIgnoreCase);
    var isLandingPage = currentPath == "/";
}
<body class="@(isAuthPage ? "auth-page" : "app-body")">

@if (isAuthPage)
{
    <main class="auth-shell">
        @RenderBody()
    </main>
}
else
{
    <!-- Unified Main Header Navigation -->
    <header class="site-nav navbar navbar-expand-lg sticky-top">
        <div class="container-fluid px-lg-4">
            <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                <span class="brand-mark">CA</span>
                <span>Cricket Auction <b>Manager</b></span>
            </a>
            
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            
            <div class="collapse navbar-collapse" id="mainNav">
                <ul class="navbar-nav me-auto ms-lg-4 align-items-lg-center gap-1">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <li class="nav-item">
                            <a class="nav-link @(currentPath.StartsWith("/Dashboard", StringComparison.OrdinalIgnoreCase) ? "active" : "")" asp-controller="Dashboard" asp-action="Index">
                                📊 Dashboard
                            </a>
                        </li>
                    }
                    <li class="nav-item">
                        <a class="nav-link @(currentPath.StartsWith("/Players", StringComparison.OrdinalIgnoreCase) ? "active" : "")" asp-controller="Players" asp-action="Index">
                            🏏 Players
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(currentPath.StartsWith("/Teams", StringComparison.OrdinalIgnoreCase) ? "active" : "")" asp-controller="Teams" asp-action="Index">
                            🛡️ Teams
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(currentPath.StartsWith("/Auctions", StringComparison.OrdinalIgnoreCase) && !currentPath.Contains("/Live") ? "active" : "")" asp-controller="Auctions" asp-action="Index">
                            📋 Auctions
                        </a>
                    </li>
                </ul>

                <div class="d-flex align-items-center gap-3 mt-3 mt-lg-0">
                    <a class="btn btn-warning nav-cta d-flex align-items-center gap-2 fw-bold" asp-controller="Auctions" asp-action="Live">
                        <span class="live-dot animate-pulse"></span> Live Console
                    </a>
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </div>
    </header>

    <main class="main-content">
        @if (!isLandingPage)
        {
            <div class="page-shell">
                @RenderBody()
            </div>
        }
        else
        {
            @RenderBody()
        }
    </main>

    <footer class="site-footer mt-auto py-4">
        <div class="container-fluid px-lg-4 d-flex flex-column flex-md-row justify-content-between align-items-center gap-2">
            <div>
                <span class="fw-bold">Cricket Auction Manager</span> · <small class="text-muted-light">Powered by ASP.NET Core 8 & Entity Framework Core</small>
            </div>
            <div class="text-muted-light small">
                © @DateTime.Now.Year POMS · All rights reserved.
            </div>
        </div>
    </footer>
}

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
