<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="A professional cricket player auction management workspace." />
    <title>@ViewData["Title"] · Cricket Auction Manager</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/matchday.css" asp-append-version="true" />
</head>
@{
    var currentPath = Context.Request.Path.Value ?? "/";
    var isAuthPage = currentPath.StartsWith("/Identity/Account/Login", StringComparison.OrdinalIgnoreCase) || currentPath.StartsWith("/Identity/Account/Register", StringComparison.OrdinalIgnoreCase);
    var isPublicPage = currentPath == "/" || currentPath.StartsWith("/Players", StringComparison.OrdinalIgnoreCase) || currentPath.StartsWith("/Teams", StringComparison.OrdinalIgnoreCase) || currentPath.StartsWith("/Auctions", StringComparison.OrdinalIgnoreCase);
}
<body class="@(isPublicPage ? "public-page" : isAuthPage ? "auth-page" : "admin-body")">
@if (isAuthPage)
{
    <main class="auth-shell">@RenderBody()</main>
}
else if (isPublicPage)
{
    <nav class="navbar navbar-expand-lg site-nav"><div class="container"><a class="navbar-brand" asp-controller="Home" asp-action="Index"><span class="brand-mark">CA</span><span>Cricket Auction <b>Manager</b></span></a><button class="navbar-toggler" data-bs-toggle="collapse" data-bs-target="#mainNav"><span class="navbar-toggler-icon"></span></button><div class="collapse navbar-collapse" id="mainNav"><ul class="navbar-nav ms-auto align-items-lg-center">@if (User.Identity?.IsAuthenticated == true) { <li class="nav-item"><a class="nav-link" asp-controller="Dashboard" asp-action="Index">Dashboard</a></li> }<li class="nav-item"><a class="nav-link" asp-controller="Players" asp-action="Index">Players</a></li><li class="nav-item"><a class="nav-link" asp-controller="Teams" asp-action="Index">Teams</a></li><li class="nav-item"><a class="nav-link" asp-controller="Auctions" asp-action="Index">Auctions</a></li><li class="nav-item ms-lg-2"><a class="btn btn-primary btn-sm nav-cta" asp-controller="Auctions" asp-action="Live">Open live console <span>↗</span></a></li></ul><partial name="_LoginPartial" /></div></div></nav>
    <main>@RenderBody()</main>
}
else
{
    <div class="admin-layout">
        <aside class="admin-sidebar offcanvas-lg offcanvas-start" tabindex="-1" id="adminSidebar"><div class="sidebar-brand"><a asp-controller="Dashboard" asp-action="Index"><span class="brand-mark">CA</span><span>Cricket Auction <b>Manager</b></span></a><button class="sidebar-close d-lg-none" data-bs-dismiss="offcanvas" data-bs-target="#adminSidebar">×</button></div><div class="sidebar-label">Workspace</div><nav class="sidebar-nav"><a class="active" asp-controller="Dashboard" asp-action="Index"><span>▦</span> Dashboard</a><a asp-controller="Players" asp-action="Index"><span>♙</span> Players</a><a asp-controller="Teams" asp-action="Index"><span>◉</span> Teams</a><a asp-controller="Auctions" asp-action="Index"><span>◈</span> Auctions</a></nav><div class="sidebar-label">Operations</div><nav class="sidebar-nav"><a class="sidebar-live" asp-controller="Auctions" asp-action="Live"><span>●</span> Live console</a></nav><div class="sidebar-bottom"><div class="sidebar-help"><span>Need a hand?</span><strong>Open the operator guide</strong><small>Keep the room moving.</small></div></div></aside>
        <div class="admin-main"><header class="admin-topbar"><button class="sidebar-collapse" id="sidebarCollapse" type="button" aria-label="Collapse sidebar">☰</button><button class="sidebar-toggle d-lg-none" data-bs-toggle="offcanvas" data-bs-target="#adminSidebar" aria-label="Open navigation">☰</button><div class="topbar-context"><span class="topbar-kicker">Auction operations</span><strong>@ViewData["Title"]</strong></div><div class="topbar-actions"><span class="topbar-date">@DateTime.Now.ToString("dd MMM yyyy")</span><partial name="_LoginPartial" /></div></header><main class="admin-content"><div class="app-page">@RenderBody()</div></main><footer class="admin-footer"><span>Cricket Auction Manager</span><span>AdminLTE-inspired workspace · .NET 8 · SQLite</span></footer></div>
    </div>
}
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>

