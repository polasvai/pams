@model Player
@{ ViewData["Title"] = "Add player"; }
<div class="card p-4"><h1 class="h3 mb-3">Add player</h1><form asp-action="Create" method="post"><div asp-validation-summary="All" class="text-danger"></div><div class="row g-3"><div class="col-md-6"><label class="form-label">Full name</label><input asp-for="FullName" class="form-control" /></div><div class="col-md-3"><label class="form-label">Role</label><select asp-for="Role" asp-items="Html.GetEnumSelectList<PlayerRole>()" class="form-select"></select></div><div class="col-md-3"><label class="form-label">Skill rating (1–100)</label><input asp-for="SkillRating" class="form-control" /></div><div class="col-md-4"><label class="form-label">Nationality</label><input asp-for="Nationality" class="form-control" /></div><div class="col-md-4"><label class="form-label">Batting style</label><input asp-for="BattingStyle" class="form-control" /></div><div class="col-md-4"><label class="form-label">Bowling style</label><input asp-for="BowlingStyle" class="form-control" /></div><div class="col-md-4"><label class="form-label">Base price</label><input asp-for="BasePrice" class="form-control" /></div></div><div class="mt-4"><button class="btn btn-primary">Save player</button> <a class="btn btn-link" asp-action="Index">Cancel</a></div></form></div>
