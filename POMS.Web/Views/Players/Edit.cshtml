@model Player
@{ ViewData["Title"] = "Edit player"; }
<div class="card p-4"><h1 class="h3 mb-3">Edit player</h1><form asp-action="Edit" method="post"><input asp-for="Id" type="hidden" /><div asp-validation-summary="All" class="text-danger"></div><div class="row g-3"><div class="col-md-6"><label class="form-label">Full name</label><input asp-for="FullName" class="form-control" /></div><div class="col-md-3"><label class="form-label">Role</label><select asp-for="Role" asp-items="Html.GetEnumSelectList<PlayerRole>()" class="form-select"></select></div><div class="col-md-3"><label class="form-label">Skill rating</label><input asp-for="SkillRating" class="form-control" /></div><div class="col-md-4"><label class="form-label">Nationality</label><input asp-for="Nationality" class="form-control" /></div><div class="col-md-4"><label class="form-label">Batting style</label><input asp-for="BattingStyle" class="form-control" /></div><div class="col-md-4"><label class="form-label">Bowling style</label><input asp-for="BowlingStyle" class="form-control" /></div><div class="col-md-4"><label class="form-label">Base price</label><input asp-for="BasePrice" class="form-control" /></div><div class="col-md-4 d-flex align-items-end"><div class="form-check"><input asp-for="IsActive" class="form-check-input" /><label asp-for="IsActive" class="form-check-label">Active</label></div></div></div><div class="mt-4"><button class="btn btn-primary">Save changes</button> <a class="btn btn-link" asp-action="Index">Cancel</a></div></form></div>
