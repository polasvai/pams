@{
    ViewData["Title"] = "Download Players Copy";
}

<div class="row justify-content-center py-5">
    <div class="col-lg-5 col-md-7">
        <div class="text-center mb-4">
            <span class="eyebrow text-primary">Retrieve Document</span>
            <h1 class="h2 font-weight-bold mb-0">Download Players Copy</h1>
            <p class="text-muted mt-2">Enter your registration details to download or print your official copy.</p>
        </div>

        <div class="card p-4 p-md-5 border-0 shadow-lg rounded-4">
            <form asp-action="DownloadCopy" method="post">
                <div asp-validation-summary="All" class="alert alert-danger py-2 small" role="alert"></div>

                <div class="mb-4">
                    <label class="form-label font-weight-bold" for="id">Player ID</label>
                    <input type="number" id="id" name="id" class="form-control form-control-lg" placeholder="e.g. 5" required />
                    <small class="text-muted">You can find this on your original registration success page.</small>
                </div>

                <div class="mb-4">
                    <label class="form-label font-weight-bold" for="mobileNumber">Mobile Number</label>
                    <input type="text" id="mobileNumber" name="mobileNumber" class="form-control form-control-lg" placeholder="e.g. 017XXXXXXXX" required />
                    <small class="text-muted">The exact mobile number used during registration.</small>
                </div>

                <button class="btn btn-primary btn-lg px-5 font-weight-bold w-100 mt-2" type="submit">Retrieve Players Copy</button>
            </form>
        </div>
    </div>
</div>
