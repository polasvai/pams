@model IEnumerable<Player>
@{ ViewData["Title"] = "Players"; }
<div class="page-heading d-flex flex-wrap justify-content-between align-items-end gap-3"><div><span class="eyebrow">Player pool</span><h1 class="h3 mb-1">Players</h1><p class="text-muted mb-0">Review the active cricket talent pool and base prices.</p></div><div class="d-flex gap-2">@if (User.Identity?.IsAuthenticated == true) { <a class="btn btn-primary" asp-action="Create">Add player</a> } else { <a class="btn btn-primary" asp-area="Identity" asp-page="/Account/Login" asp-route-returnUrl="/Players">Sign in to manage</a> }</div></div>
@if (TempData["Success"] is string success) { <div class="alert alert-success">@success</div> }
<div class="players-toolbar"><form method="get"><input class="form-control" name="search" value="@ViewBag.Search" placeholder="Search by player name" /><button class="btn btn-primary">Search</button></form><span class="count-chip">@Model.Count() players</span></div>
<div class="card"><div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead><tr><th>Name</th><th>Role</th><th>Rating</th><th>Base price</th><th>Status</th><th></th></tr></thead><tbody>
@foreach (var player in Model) { <tr><td class="fw-semibold">@player.FullName<br /><small class="text-muted">@player.Nationality</small></td><td>@player.Role</td><td class="rating-cell">@player.SkillRating</td><td class="price-cell">₹@player.BasePrice.ToString("N0")</td><td><span class="badge @(player.IsActive ? "bg-success" : "bg-secondary")">@(player.IsActive ? "Active" : "Archived")</span></td><td class="text-end">@if (User.Identity?.IsAuthenticated == true) { <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@player.Id">Edit</a> }</td></tr> }
</tbody></table></div></div>
