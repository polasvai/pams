@model IEnumerable<Player>
@{ 
    ViewData["Title"] = "Player Directory"; 
    var search = ViewBag.Search as string;
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <span class="eyebrow">Cricket Talent Pool</span>
        <h1 class="h2 font-weight-bold mb-0">Players</h1>
    </div>
    @if (User.Identity?.IsAuthenticated == true)
    {
        <a class="btn btn-primary font-weight-bold" asp-action="Create">➕ Add Player</a>
    }
</div>

@if (TempData["Success"] is string success)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        ✓ @success
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="card p-3 mb-4">
    <form method="get" class="row g-2 align-items-center">
        <div class="col-md-8">
            <div class="input-group">
                <span class="input-group-text bg-white border-end-0">🔍</span>
                <input class="form-control border-start-0" name="search" value="@search" placeholder="Search by player name or mobile number..." />
            </div>
        </div>
        <div class="col-md-4 d-flex gap-2">
            <button class="btn btn-primary flex-grow-1" type="submit">Search</button>
            @if (!string.IsNullOrWhiteSpace(search))
            {
                <a class="btn btn-outline-secondary" asp-action="Index">Clear</a>
            }
        </div>
    </form>
</div>

<div class="card overflow-hidden">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>Player</th>
                    <th>Role</th>
                    <th>Skill Rating</th>
                    <th>Base Price</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Any())
                {
                    foreach (var player in Model)
                    {
                        <tr>
                            <td>
                                <div class="d-flex align-items-center gap-3">
                                    @if (!string.IsNullOrEmpty(player.ProfilePictureUrl))
                                    {
                                        <img src="@player.ProfilePictureUrl" alt="Pic" class="rounded-circle" style="width: 40px; height: 40px; object-fit: cover;" />
                                    }
                                    else
                                    {
                                        <div class="rounded-circle bg-light d-flex align-items-center justify-content-center text-muted" style="width: 40px; height: 40px;">
                                            <small>👤</small>
                                        </div>
                                    }
                                    <div>
                                        <strong class="d-block text-dark">@player.FullName</strong>
                                        <small class="text-muted">
                                            @(string.IsNullOrEmpty(player.MobileNumber) ? "No Mobile" : player.MobileNumber)
                                            @if (!string.IsNullOrEmpty(player.BattingStyle)) { <span> · @player.BattingStyle</span> }
                                            @if (!string.IsNullOrEmpty(player.BowlingStyle)) { <span> · @player.BowlingStyle</span> }
                                        </small>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <span class="badge bg-light text-dark border">@player.Role</span>
                            </td>
                            <td>
                                <div class="d-flex align-items-center gap-2" style="max-width: 140px;">
                                    <div class="progress flex-grow-1" style="height: 6px;">
                                        <div class="progress-bar bg-primary" role="progressbar" style="width: @player.SkillRating%;"></div>
                                    </div>
                                    <small class="font-weight-bold">@player.SkillRating</small>
                                </div>
                            </td>
                            <td class="font-weight-bold">৳@player.BasePrice.ToString("N0")</td>
                            <td>
                                <span class="badge @(player.IsActive ? "bg-success" : "bg-secondary")">
                                    @(player.IsActive ? "Active" : "Archived")
                                </span>
                            </td>
                            <td class="text-end">
                                @if (User.Identity?.IsAuthenticated == true)
                                {
                                    <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@player.Id">Edit</a>
                                }
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" class="text-center py-5 text-muted">
                            No players found matching your criteria.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
