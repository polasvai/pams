@model IEnumerable<Player>
@{ 
    ViewData["Title"] = "Player Directory"; 
    var search = ViewBag.Search as string;
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <span class="eyebrow">Cricket Talent Pool</span>
        <h1 class="h2 font-weight-bold mb-0">Players</h1>
    </div>
    @if (User.Identity?.IsAuthenticated == true)
    {
        <a class="btn btn-primary font-weight-bold" asp-action="Create">➕ Add Player</a>
    }
</div>

@if (TempData["Success"] is string success)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        ✓ @success
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        ⚠️ @error
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="card p-3 mb-4">
    <form method="get" class="row g-2 align-items-center">
        <div class="col-md-8">
            <div class="input-group">
                <span class="input-group-text bg-white border-end-0">🔍</span>
                <input class="form-control border-start-0" name="search" value="@search" placeholder="Search by player name or mobile number..." />
            </div>
        </div>
        <div class="col-md-4 d-flex gap-2">
            <button class="btn btn-primary flex-grow-1" type="submit">Search</button>
            @if (!string.IsNullOrWhiteSpace(search))
            {
                <a class="btn btn-outline-secondary" asp-action="Index">Clear</a>
            }
        </div>
    </form>
</div>

<div class="card overflow-hidden">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th style="width: 50px;">SL</th>
                    <th style="width: 80px;">ID</th>
                    <th>Player</th>
                    <th>Category</th>
                    <th>Role</th>
                    <th>Base Price</th>
                    <th>Status</th>
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <th class="text-end">Actions</th>
                    }
                </tr>
            </thead>
            <tbody>
                @if (Model.Any())
                {
                    int serialNumber = 1;
                    foreach (var player in Model)
                    {
                        <tr>
                            <td><span class="text-muted fw-bold">@serialNumber</span></td>
                            <td><span class="text-secondary font-weight-bold">#@player.Id.ToString("D5")</span></td>
                            <td>
                                <div class="d-flex align-items-center gap-3">
                                    @if (!string.IsNullOrEmpty(player.ProfilePictureUrl))
                                    {
                                        <img src="@player.ProfilePictureUrl" alt="Pic" class="rounded-circle" style="width: 40px; height: 40px; object-fit: cover;" />
                                    }
                                    else
                                    {
                                        <div class="rounded-circle bg-light d-flex align-items-center justify-content-center text-muted" style="width: 40px; height: 40px;">
                                            <small>👤</small>
                                        </div>
                                    }
                                    <div>
                                        <div class="d-flex align-items-center gap-2">
                                            <strong class="d-block text-dark">@player.FullName</strong>
                                        </div>
                                        <small class="text-muted">
                                            @(string.IsNullOrEmpty(player.MobileNumber) ? "No Mobile" : player.MobileNumber)
                                            @if (!string.IsNullOrEmpty(player.BattingStyle)) { <span> · @player.BattingStyle</span> }
                                            @if (!string.IsNullOrEmpty(player.BowlingStyle)) { <span> · @player.BowlingStyle</span> }
                                        </small>
                                    </div>
                                </div>
                            </td>
                            <td>
                                @if (!string.IsNullOrEmpty(player.Category))
                                {
                                    <span class="badge bg-primary">@player.Category</span>
                                }
                            </td>
                            <td>
                                <span class="badge bg-light text-dark border">@player.Role</span>
                            </td>
                            <td class="font-weight-bold">৳@player.BasePrice.ToString("N0")</td>
                            <td>
                                @{
                                    var soldTeams = ViewBag.SoldPlayerTeams as Dictionary<int, string> ?? new();
                                    var isSold = soldTeams.TryGetValue(player.Id, out var teamName);
                                }
                                <div class="d-flex flex-column gap-1 align-items-start">
                                    @if (isSold)
                                    {
                                        <span class="badge bg-success">
                                            Sold (@teamName)
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">
                                            Unsold
                                        </span>
                                    }
                                    @if (!player.IsActive)
                                    {
                                        <span class="badge bg-secondary" style="font-size: 0.7rem;">Archived</span>
                                    }
                                </div>
                            </td>
                            @if (User.Identity?.IsAuthenticated == true)
                            {
                                <td class="text-end">
                                    <div class="d-flex justify-content-end gap-1">
                                        <form asp-action="ToggleActive" asp-route-id="@player.Id" method="post">
                                            <button type="submit" class="btn btn-sm px-2 @(player.IsActive ? "btn-warning" : "btn-success")" title="@(player.IsActive ? "Deactivate" : "Activate")">
                                                @(player.IsActive ? "⛔" : "✅")
                                            </button>
                                        </form>
                                        <a class="btn btn-sm btn-outline-info px-2" asp-action="Print" asp-route-id="@player.Id" target="_blank" title="Print Players Copy">🖨️</a>
                                        <a class="btn btn-sm btn-outline-secondary px-2" asp-action="Edit" asp-route-id="@player.Id" title="Edit">✏️</a>
                                        <form asp-action="Delete" asp-route-id="@player.Id" method="post" onsubmit="return confirm('Are you sure you want to permanently delete this player?');">
                                            <button type="submit" class="btn btn-sm btn-danger px-2" title="Delete">🗑️</button>
                                        </form>
                                    </div>
                                </td>
                            }
                        </tr>
                        serialNumber++;
                    }
                }
                else
                {
                    <tr>
                        <td colspan="@(User.Identity?.IsAuthenticated == true ? 8 : 7)" class="text-center py-5 text-muted">
                            No players found matching your criteria.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
