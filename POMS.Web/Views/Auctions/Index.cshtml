@model IEnumerable<Auction>
@{ ViewData["Title"] = "Auctions Directory"; }

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <span class="eyebrow">Events & Schedules</span>
        <h1 class="h2 font-weight-bold mb-0">Auctions</h1>
    </div>
    @if (User.Identity?.IsAuthenticated == true)
    {
        <a class="btn btn-primary font-weight-bold" asp-action="Create">➕ Create Auction</a>
    }
</div>

@if (TempData["Success"] is string success)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        ✓ @success
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        ⚠️ @error
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="card overflow-hidden">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>Auction Name</th>
                    <th>Status</th>
                    <th>Lots Configured</th>
                    <th>Starts At</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Any())
                {
                    foreach (var auction in Model)
                    {
                        var statusClass = auction.Status == AuctionStatus.Paused ? "status-paused" : auction.Status == AuctionStatus.Live ? "status-live" : auction.Status == AuctionStatus.Completed ? "status-completed" : "status-draft";
                        <tr>
                            <td>
                                <strong class="d-block text-dark fs-6">@auction.Name</strong>
                                <small class="text-muted">Min Increment: ৳@auction.MinimumIncrement.ToString("N0")</small>
                            </td>
                            <td>
                                <span class="status-pill @statusClass">
                                    @if (auction.Status == AuctionStatus.Live) { <i class="live-dot animate-pulse"></i> }
                                    @auction.Status
                                </span>
                            </td>
                            <td>
                                <span class="badge bg-light text-dark border">@auction.AuctionPlayers.Count lot(s)</span>
                            </td>
                            <td class="text-muted small">
                                @(auction.StartsAt == default ? "Not started" : auction.StartsAt.ToLocalTime().ToString("g"))
                            </td>
                            <td class="text-end">
                                <div class="d-flex justify-content-end gap-2">
                                    <a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@auction.Id">Details</a>
                                    @if (auction.Status == AuctionStatus.Live || auction.Status == AuctionStatus.Paused)
                                    {
                                        <a class="btn btn-sm btn-warning font-weight-bold" asp-action="Live" asp-route-id="@auction.Id">Live Room ↗</a>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" class="text-center py-5 text-muted">
                            No auction events found.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
