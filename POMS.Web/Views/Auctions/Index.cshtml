@model IEnumerable<Auction>
@{ ViewData["Title"] = "Auctions"; }
<div class="page-heading d-flex flex-wrap justify-content-between align-items-end gap-3"><div><span class="eyebrow">Public auction schedule</span><h1 class="h3 mb-1">Auctions</h1><p class="text-muted mb-0">Browse auction events, lots, and live status.</p></div>@if (User.Identity?.IsAuthenticated == true) { <a class="btn btn-primary" asp-action="Create">Create auction</a> } else { <a class="btn btn-primary" asp-area="Identity" asp-page="/Account/Login" asp-route-returnUrl="/Auctions">Sign in to manage</a> }</div>
@if (TempData["Success"] is string success) { <div class="alert alert-success">@success</div> } @if (TempData["Error"] is string error) { <div class="alert alert-danger">@error</div> }
<div class="card"><div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead><tr><th>Auction</th><th>Status</th><th>Players</th><th>Started</th><th></th></tr></thead><tbody>@foreach (var auction in Model) { <tr><td class="fw-semibold">@auction.Name</td><td><span class="auction-status @auction.Status.ToString().ToLowerInvariant()">@auction.Status</span></td><td class="lot-count">@auction.AuctionPlayers.Count lots</td><td>@(auction.StartsAt == default ? "Not started" : auction.StartsAt.ToString("g"))</td><td class="text-end">@if (User.Identity?.IsAuthenticated == true) { <a class="btn btn-sm btn-outline-primary" asp-action="Details" asp-route-id="@auction.Id">Configure</a> } else { <a class="btn btn-sm btn-outline-primary" asp-action="Details" asp-route-id="@auction.Id">View details</a> } @if (auction.Status == AuctionStatus.Live || auction.Status == AuctionStatus.Paused) { <a class="btn btn-sm btn-primary" asp-action="Live" asp-route-id="@auction.Id">View live</a> }</td></tr> }</tbody></table></div></div>
