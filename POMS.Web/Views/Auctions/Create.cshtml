@model Auction
@{ ViewData["Title"] = "Create auction"; }
<div class="card p-4"><h1 class="h3 mb-3">Create auction</h1><form asp-action="Create" method="post"><div asp-validation-summary="All" class="text-danger"></div><div class="row g-3"><div class="col-md-8"><label class="form-label">Auction name</label><input asp-for="Name" class="form-control" placeholder="e.g. 2026 Premier Cricket Auction" /></div><div class="col-md-4"><label class="form-label">Minimum increment</label><input asp-for="MinimumIncrement" class="form-control" /></div><div class="col-md-6"><label class="form-label">Starts at</label><input asp-for="StartsAt" type="datetime-local" class="form-control" /></div><div class="col-md-6"><label class="form-label">Ends at</label><input asp-for="EndsAt" type="datetime-local" class="form-control" /></div></div><div class="mt-4"><button class="btn btn-primary">Save draft</button> <a class="btn btn-link" asp-action="Index">Cancel</a></div></form></div>
