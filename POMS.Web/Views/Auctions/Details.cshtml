@model Auction
@{ ViewData["Title"] = Model.Name; }
<div class="d-flex justify-content-between align-items-center mb-3"><div><h1 class="h3">@Model.Name</h1><span class="badge @(Model.Status == AuctionStatus.Live ? "bg-success" : Model.Status == AuctionStatus.Paused ? "bg-warning text-dark" : "bg-secondary")">@Model.Status</span></div><a class="btn btn-link" asp-action="Index">Back to auctions</a></div>
@if (TempData["Success"] is string success) { <div class="alert alert-success">@success</div> } @if (TempData["Error"] is string error) { <div class="alert alert-danger">@error</div> }
<div class="row g-4 auction-details"><div class="col-lg-7"><div class="card p-4"><h2 class="h5">Auction lots</h2><div class="table-responsive"><table class="table"><thead><tr><th>#</th><th>Player</th><th>Role</th><th>Status</th><th>Price</th></tr></thead><tbody>@foreach (var lot in Model.AuctionPlayers.OrderBy(x => x.LotNumber)) { <tr><td>@lot.LotNumber</td><td>@lot.Player.FullName</td><td>@lot.Player.Role</td><td>@lot.Status</td><td>₹@(lot.SoldPrice?.ToString("N0") ?? "-")</td></tr> }</tbody></table></div></div></div><div class="col-lg-5"><div class="card p-4 mb-3"><h2 class="h5">Auction controls</h2><div class="d-grid gap-2">@if (Model.Status == AuctionStatus.Draft) { <form asp-action="Start" asp-route-id="@Model.Id"><button class="btn btn-success">Start auction</button></form> } @if (Model.Status == AuctionStatus.Live) { <form asp-action="Status" asp-route-id="@Model.Id"><input type="hidden" name="status" value="Paused" /><button class="btn btn-warning">Pause auction</button></form> } @if (Model.Status == AuctionStatus.Paused) { <form asp-action="Status" asp-route-id="@Model.Id"><input type="hidden" name="status" value="Live" /><button class="btn btn-success">Resume auction</button></form><a class="btn btn-primary" asp-action="Live" asp-route-id="@Model.Id">Open live console</a> } @if (Model.Status == AuctionStatus.Live || Model.Status == AuctionStatus.Paused) { <form asp-action="Status" asp-route-id="@Model.Id"><input type="hidden" name="status" value="Completed" /><button class="btn btn-outline-danger">Complete auction</button></form> }</div></div>@if (Model.Status == AuctionStatus.Draft) { <div class="card p-4"><h2 class="h5">Add players to auction</h2><form asp-action="AddPlayers" asp-route-id="@Model.Id" method="post"><div class="mb-3">@await Html.PartialAsync("_PlayerCheckboxes")</div><button class="btn btn-primary">Add selected players</button></form></div> }</div></div>
