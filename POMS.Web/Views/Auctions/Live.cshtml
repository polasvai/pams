@model Auction?
@{
    ViewData["Title"] = "Live Auction Console";
    var teams = (IEnumerable<Team>)(ViewBag.Teams ?? Array.Empty<Team>());
    var pending = (IEnumerable<AuctionPlayer>)(ViewBag.PendingLots ?? Array.Empty<AuctionPlayer>());
    var bids = (IEnumerable<Bid>)(ViewBag.Bids ?? Array.Empty<Bid>());
    var current = Model?.CurrentAuctionPlayer;
    var highest = bids.FirstOrDefault();
}
@if (Model is null)
{
    <section class="empty-state-page"><div class="empty-state-icon">📣</div><span class="eyebrow">Operator workspace</span><h1>No live auction is running</h1><p class="lead">Create an auction, add players to the lot list, and start the event. The live console will be available here when the auction is live.</p><div class="d-flex flex-wrap justify-content-center gap-2 mt-4"><a class="btn btn-primary btn-lg" asp-action="Create">Create an auction</a><a class="btn btn-outline-secondary btn-lg" asp-action="Index">View all auctions</a></div><div class="setup-steps mt-5"><div><span>1</span><strong>Create</strong><small>Set your auction rules</small></div><div><span>2</span><strong>Build lots</strong><small>Add players to the list</small></div><div><span>3</span><strong>Go live</strong><small>Run the auction</small></div></div></section>
}
else
{
    var statusClass = Model.Status == AuctionStatus.Paused ? "status-paused" : Model.Status == AuctionStatus.Live ? "status-live" : "status-draft";
    <div class="page-heading d-flex flex-wrap justify-content-between align-items-end gap-3"><div><span class="eyebrow">Operator console</span><h1 class="mb-1">@Model.Name</h1><p class="text-muted mb-0">Manage the current lot, record bids, and publish the result.</p></div><div class="d-flex align-items-center gap-2"><span class="status-pill @statusClass"><i></i>@Model.Status</span>@if (User.Identity?.IsAuthenticated == true) { <a class="btn btn-outline-secondary" asp-action="Details" asp-route-id="@Model.Id">Auction settings</a> }</div></div>
    @if (TempData["Success"] is string success) { <div class="alert alert-success alert-soft mt-4">✓ @success</div> }
    @if (TempData["Error"] is string error) { <div class="alert alert-danger alert-soft mt-4">! @error</div> }
    @if (Model.Status == AuctionStatus.Paused) { <div class="alert alert-warning alert-soft mt-4">Bidding is paused. Resume the auction from auction settings before accepting bids.</div> }
    @if (Model.Status == AuctionStatus.Draft) { <div class="alert alert-info alert-soft mt-4">This auction is still a draft. Add players and start it from auction settings before accepting bids.</div> }

    <div class="row g-4 mt-1"><div class="col-xl-8"><section class="console-card lot-stage text-center"><div class="stage-kicker">Now on the block</div>@if (current is null) { <div class="stage-placeholder">Choose a player from the lot queue</div> } else { <h2 class="stage-player">@current.Player.FullName</h2><p class="text-muted">@current.Player.Role · Skill rating @current.Player.SkillRating · Base price ₹@current.Player.BasePrice.ToString("N0")</p> }@if (highest is not null) { <div class="highest-bid"><span>Highest bid</span><strong>₹@highest.Amount.ToString("N0")</strong><small>@highest.Team.Name</small></div> }</section>@if (current is not null && Model.Status == AuctionStatus.Live) { <section class="console-card mt-4"><div class="section-heading"><div><span class="eyebrow">Record transaction</span><h2 class="h4 mb-0">Place a bid</h2></div><span class="helper-text">Minimum: ₹@((highest?.Amount ?? current.Player.BasePrice) + Model.MinimumIncrement).ToString("N0")</span></div><form asp-action="PlaceBid" asp-route-id="@Model.Id" method="post" class="bid-form mt-4"><input type="hidden" name="lotId" value="@current.Id" /><div class="row g-3 align-items-end"><div class="col-lg-6"><label class="form-label">Bidding team</label><select name="teamId" class="form-select form-select-lg" required><option value="">Select a team</option>@foreach (var team in teams) { <option value="@team.Id">@team.Name · ₹@team.TotalBudget.ToString("N0") purse</option> }</select></div><div class="col-lg-4"><label class="form-label">Bid amount</label><input name="amount" type="number" step="0.01" min="0" class="form-control form-control-lg" placeholder="₹ amount" required /></div><div class="col-lg-2"><button class="btn btn-primary btn-lg w-100">Place bid</button></div></div></form><div class="result-actions mt-4"><span class="text-muted small me-2">Close this lot as:</span><form asp-action="FinishPlayer" asp-route-id="@Model.Id" method="post" class="d-inline"><input type="hidden" name="sold" value="true" /><button class="btn btn-success">Sold</button></form><form asp-action="FinishPlayer" asp-route-id="@Model.Id" method="post" class="d-inline ms-2"><input type="hidden" name="sold" value="false" /><button class="btn btn-outline-danger">Unsold</button></form></div></section> }</div><div class="col-xl-4"><section class="console-card mb-4"><div class="section-heading"><div><span class="eyebrow">Lot queue</span><h2 class="h4 mb-0">Select next player</h2></div><span class="count-badge">@pending.Count()</span></div>@if (pending.Any()) { <form asp-action="SelectPlayer" asp-route-id="@Model.Id" method="post" class="mt-3"><select name="lotId" class="form-select mb-2" required><option value="">Choose a pending lot</option>@foreach (var lot in pending) { <option value="@lot.Id">#@lot.LotNumber · @lot.Player.FullName — ₹@lot.Player.BasePrice.ToString("N0")</option> }</select><button class="btn btn-outline-primary w-100">Bring to block</button></form> } else { <p class="text-muted small mb-0 mt-3">No pending players remain.</p> }</section><section class="console-card"><div class="section-heading"><div><span class="eyebrow">Audit trail</span><h2 class="h4 mb-0">Bid history</h2></div></div>@if (bids.Any()) { <div class="table-responsive mt-3"><table class="table table-sm align-middle mb-0"><thead><tr><th>Team</th><th>Bid</th><th>Time</th></tr></thead><tbody>@foreach (var bid in bids) { <tr class="@(bid.IsWinning ? "table-primary fw-bold" : "")"><td>@bid.Team.Name</td><td>₹@bid.Amount.ToString("N0")</td><td>@bid.PlacedAt.ToLocalTime().ToString("t")</td></tr> }</tbody></table></div> } else { <p class="text-muted small mb-0 mt-3">No bids have been recorded for this lot.</p> }</section></div></div>
}
