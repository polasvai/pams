@model Auction?
@{
    ViewData["Title"] = Model?.Name ?? "Live Auction Console";
    var teams = (IEnumerable<Team>)(ViewBag.Teams ?? Array.Empty<Team>());
    var pending = (IEnumerable<AuctionPlayer>)(ViewBag.PendingLots ?? Array.Empty<AuctionPlayer>());
    var preferredOrder = new List<string> { "Icon", "A", "B", "C", "D", "Local", "Foreign" };
    var categorizedPending = pending
        .GroupBy(x => string.IsNullOrWhiteSpace(x.Player.Category) ? "Unassigned" : x.Player.Category.Trim())
        .OrderBy(g =>
        {
            var idx = preferredOrder.FindIndex(o => o.Equals(g.Key, StringComparison.OrdinalIgnoreCase));
            return idx >= 0 ? idx : 999;
        })
        .ThenBy(g => g.Key)
        .ToList();
    var bids = (IEnumerable<Bid>)(ViewBag.Bids ?? Array.Empty<Bid>());
    var current = Model?.CurrentAuctionPlayer;
    var highest = bids.FirstOrDefault();
    var minBidAmount = highest?.Amount + 1 ?? current?.Player.BasePrice ?? 0;
}

@if (Model is null)
{
    <div class="empty-state py-5 my-4 text-center">
        <div class="display-1 mb-3">📣</div>
        <span class="eyebrow">Operator Workspace</span>
        <h1 class="h2 font-weight-bold">No Live Auction Active</h1>
        <p class="text-muted lead max-w-md mx-auto">
            Create an auction event, populate the player lot list, and launch the live room.
        </p>
        <div class="d-flex justify-content-center gap-3 mt-4">
            <a class="btn btn-primary btn-lg" asp-action="Create">Create Auction</a>
            <a class="btn btn-outline-secondary btn-lg" asp-action="Index">Browse All Auctions</a>
        </div>
    </div>
}
else
{
    var statusClass = Model.Status == AuctionStatus.Paused ? "status-paused" : Model.Status == AuctionStatus.Live ? "status-live" : "status-draft";
    
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="status-pill @statusClass">
                    @if (Model.Status == AuctionStatus.Live) { <i class="live-dot animate-pulse"></i> }
                    @Model.Status
                </span>
                @if (Model.MinimumIncrement > 0)
                {
                    <span class="text-muted small">Min Increment: ৳@Model.MinimumIncrement.ToString("N0")</span>
                }
            </div>
            <h1 class="h2 font-weight-bold mb-0">@Model.Name</h1>
        </div>
        
        <div class="d-flex align-items-center gap-2">
            @if (User.Identity?.IsAuthenticated == true)
            {
                if (Model.Status == AuctionStatus.Live)
                {
                    <form asp-action="Status" asp-route-id="@Model.Id" method="post" class="d-inline">
                        <input type="hidden" name="status" value="Paused" />
                        <button class="btn btn-outline-warning btn-sm fw-bold">⏸️ Pause Bidding</button>
                    </form>
                }
                else if (Model.Status == AuctionStatus.Paused)
                {
                    <form asp-action="Status" asp-route-id="@Model.Id" method="post" class="d-inline">
                        <input type="hidden" name="status" value="Live" />
                        <button class="btn btn-success btn-sm fw-bold">▶️ Resume Bidding</button>
                    </form>
                }
                <a class="btn btn-outline-secondary btn-sm" asp-action="Details" asp-route-id="@Model.Id">Settings & Lots</a>
            }
            <button class="btn btn-light btn-sm border" onclick="location.reload()" title="Refresh live status">
                🔄 Refresh
            </button>
        </div>
    </div>

    @if (TempData["Success"] is string success)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            ✓ @success
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["Error"] is string error)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            ⚠️ @error
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row g-4">
        <!-- Main Stage Column -->
        <div class="col-xl-8">
            <!-- Stage Centerpiece -->
            <div class="lot-stage">
                @if (current is null)
                {
                    <div class="py-5 text-center">
                        <span class="stage-kicker d-block mb-2">NOW ON THE BLOCK</span>
                        <div class="display-4 mb-2">⏳</div>
                        <h3 class="text-white-50">Waiting for Next Lot Selection</h3>
                        <p class="text-muted">Select a pending lot from the queue to start bidding.</p>
                    </div>
                }
                else
                {
                    <div class="row align-items-center g-4">
                        <!-- Left Half: Player Photo / Card -->
                        <div class="col-md-5 text-center">
                            <div class="position-relative d-inline-block">
                                @if (!string.IsNullOrEmpty(current.Player.ProfilePictureUrl))
                                {
                                    <img src="@current.Player.ProfilePictureUrl" alt="@current.Player.FullName" class="img-fluid rounded-4 shadow-lg border border-3" style="max-height: 290px; width: 100%; max-width: 260px; object-fit: cover; border-color: rgba(255,255,255,0.25) !important;" />
                                }
                                else
                                {
                                    <div class="rounded-4 d-flex align-items-center justify-content-center shadow-lg border border-3 mx-auto" style="width: 220px; height: 260px; background: rgba(255,255,255,0.06); border-color: rgba(255,255,255,0.2) !important;">
                                        <span class="display-1 text-white-50">👤</span>
                                    </div>
                                }
                                @if (!string.IsNullOrEmpty(current.Player.Category))
                                {
                                    <div class="position-absolute top-0 start-0 m-2">
                                        <span class="badge bg-warning text-dark font-weight-bold px-3 py-1 shadow-sm fs-6">
                                            @current.Player.Category
                                        </span>
                                    </div>
                                }
                            </div>
                        </div>

                        <!-- Right Half: Player Information & Highest Bid -->
                        <div class="col-md-7 text-start">
                            <span class="stage-kicker d-block mb-1">NOW ON THE BLOCK</span>
                            <h2 class="stage-player mb-2" style="line-height: 1.15;">@current.Player.FullName</h2>

                            <div class="d-flex flex-wrap gap-2 mb-3">
                                <span class="badge bg-primary px-3 py-2 fs-6">@current.Player.Role</span>
                                <span class="badge bg-secondary px-3 py-2 fs-6">Rating: @current.Player.SkillRating/100</span>
                                @if (!string.IsNullOrEmpty(current.Player.Nationality))
                                {
                                    <span class="badge bg-dark px-3 py-2 fs-6">🌐 @current.Player.Nationality</span>
                                }
                            </div>

                            <div class="text-light mb-3" style="font-size: 0.95rem;">
                                <div class="mb-1">
                                    Base Price: <strong class="text-warning fs-5">৳@current.Player.BasePrice.ToString("N0")</strong>
                                </div>
                                <div class="text-white-50">
                                    @if (!string.IsNullOrEmpty(current.Player.BattingStyle)) { <span>🏏 @current.Player.BattingStyle Bat</span> }
                                    @if (!string.IsNullOrEmpty(current.Player.BowlingStyle)) { <span class="ms-2">🎯 @current.Player.BowlingStyle</span> }
                                </div>
                                @if (!string.IsNullOrEmpty(current.Player.JerseyNumber) || !string.IsNullOrEmpty(current.Player.JerseySize))
                                {
                                    <div class="text-white-50 small mt-1">
                                        @if (!string.IsNullOrEmpty(current.Player.JerseyNumber)) { <span>Jersey #: @current.Player.JerseyNumber</span> }
                                        @if (!string.IsNullOrEmpty(current.Player.JerseySize)) { <span class="ms-2">Size: @current.Player.JerseySize</span> }
                                    </div>
                                }
                            </div>

                            <div class="highest-bid-box mt-2">
                                <span class="text-uppercase small font-weight-bold text-light opacity-75">Highest Bid</span>
                                <div class="highest-bid-amount">
                                    ৳@(highest?.Amount.ToString("N0") ?? current.Player.BasePrice.ToString("N0"))
                                </div>
                                <small class="text-light font-weight-bold">
                                    @(highest is not null ? $"Held by {highest.Team.Name}" : "Opening Lot Price")
                                </small>
                            </div>
                        </div>
                    </div>
                }
            </div>

            <!-- Bidding Actions (Only if authenticated operator & auction is Live) -->
            @if (current is not null && Model.Status == AuctionStatus.Live)
            {
                if (User.Identity?.IsAuthenticated == true)
                {
                    <div class="card p-4 mt-4 shadow-sm border-2">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h3 class="h5 mb-0 font-weight-bold">🔨 Sell Player to Team</h3>
                            <span class="badge bg-light text-dark border">
                                Base Price: <strong>৳@current.Player.BasePrice.ToString("N0")</strong>
                            </span>
                        </div>

                        <form asp-action="SellPlayer" asp-route-id="@Model.Id" method="post" id="sellPlayerForm">
                            <input type="hidden" name="lotId" value="@current.Id" />
                            <div class="row g-3 align-items-end">
                                <div class="col-lg-5">
                                    <label class="form-label font-weight-bold">Select Team</label>
                                    <select name="teamId" class="form-select form-select-lg" required>
                                        <option value="">-- Select Team --</option>
                                        @foreach (var team in teams)
                                        {
                                            <option value="@team.Id" data-budget="@team.TotalBudget">@team.Name (Purse: ৳@team.TotalBudget.ToString("N0"))</option>
                                        }
                                    </select>
                                </div>
                                <div class="col-lg-4">
                                    <label class="form-label font-weight-bold">Bid / Sold Amount (৳)</label>
                                    <input name="amount" id="bidAmountInput" type="number" step="any" min="0" value="@current.Player.BasePrice" class="form-control form-control-lg" required />
                                </div>
                                <div class="col-lg-3">
                                    <button class="btn btn-success btn-lg w-100 font-weight-bold shadow-sm" type="submit">
                                        🔨 Sold to Selected Team
                                    </button>
                                </div>
                            </div>
                        </form>

                        <script>
                            document.querySelector('select[name="teamId"]').addEventListener('change', function(e) {
                                var selectedOption = e.target.options[e.target.selectedIndex];
                                var budget = selectedOption.getAttribute('data-budget');
                                if (budget) {
                                    document.getElementById('bidAmountInput').max = budget;
                                } else {
                                    document.getElementById('bidAmountInput').removeAttribute('max');
                                }
                            });
                        </script>

                        <hr class="my-4" />

                        <!-- Lot Conclusion Actions -->
                        <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
                            <span class="text-muted small">No buyers for this player?</span>
                            <form asp-action="FinishPlayer" asp-route-id="@Model.Id" method="post" onsubmit="return confirm('Are you sure you want to mark this player as UNSOLD?');">
                                <input type="hidden" name="sold" value="false" />
                                <button class="btn btn-outline-danger font-weight-bold px-3" type="submit">
                                    ❌ Mark Unsold
                                </button>
                            </form>
                        </div>
                    </div>
                }
                else
                {
                    <div class="alert alert-info mt-4 d-flex align-items-center gap-3">
                        <span class="fs-3">🔒</span>
                        <div>
                            <strong>Spectator Mode</strong>
                            <p class="mb-0 small">You are viewing the live auction. <a asp-controller="Account" asp-action="Login" asp-route-returnUrl="@Context.Request.Path" class="fw-bold">Sign in as operator</a> to place bids.</p>
                        </div>
                    </div>
                }
            }
        </div>

        <!-- Sidebar Column (Lot Queue & Bidding Audit Trail) -->
        <div class="col-xl-4">
            <!-- Next Player Queue (Grouped by Category with Live Search) -->
            <div class="card p-3 mb-4 shadow-sm border-0">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <h3 class="h6 font-weight-bold text-uppercase text-muted mb-0">Lot Queue</h3>
                    <span class="badge bg-primary rounded-pill">@pending.Count() Pending</span>
                </div>

                @if (pending.Any())
                {
                    <!-- Live Search Input -->
                    <div class="mb-2">
                        <div class="input-group input-group-sm">
                            <span class="input-group-text bg-white border-end-0">🔍</span>
                            <input type="text" id="queueLiveSearchInput" class="form-control form-control-sm border-start-0" placeholder="Live search by name, role, category..." autocomplete="off" />
                            <button type="button" class="btn btn-outline-secondary btn-sm" id="btnQueueSearchClear" style="display: none;">✕</button>
                        </div>
                    </div>

                    <!-- Category Filter Pills -->
                    @if (categorizedPending.Count > 1)
                    {
                        <div class="d-flex flex-wrap gap-1 mb-2">
                            <button type="button" class="btn btn-sm btn-dark py-0 px-2 queue-cat-filter active" data-cat="ALL" style="font-size: 0.72rem;">
                                All (@pending.Count())
                            </button>
                            @foreach (var group in categorizedPending)
                            {
                                <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-2 queue-cat-filter" data-cat="@group.Key.ToLowerInvariant()" style="font-size: 0.72rem;">
                                    @group.Key (@group.Count())
                                </button>
                            }
                        </div>
                    }

                    @if (User.Identity?.IsAuthenticated == true && Model.Status == AuctionStatus.Live)
                    {
                        <!-- Quick Call Dropdown by Category for Operator -->
                        <form asp-action="SelectPlayer" asp-route-id="@Model.Id" method="post" class="mb-3" id="quickSelectForm">
                            <div class="input-group input-group-sm">
                                <select name="lotId" id="queueSelectDropdown" class="form-select form-select-sm" required>
                                    <option value="">-- Select Next Player --</option>
                                    @foreach (var group in categorizedPending)
                                    {
                                        <optgroup label="@group.Key Category (@group.Count())" class="queue-optgroup" data-cat="@group.Key.ToLowerInvariant()">
                                            @foreach (var lot in group)
                                            {
                                                <option value="@lot.Id" class="queue-option" data-cat="@(string.IsNullOrWhiteSpace(lot.Player.Category) ? "unassigned" : lot.Player.Category.Trim().ToLowerInvariant())" data-name="@lot.Player.FullName.ToLowerInvariant()" data-role="@lot.Player.Role.ToString().ToLowerInvariant()">
                                                    #@lot.LotNumber · @lot.Player.FullName (@lot.Player.Role) - ৳@lot.Player.BasePrice.ToString("N0")
                                                </option>
                                            }
                                        </optgroup>
                                    }
                                </select>
                                <button class="btn btn-primary btn-sm fw-bold px-3" type="submit" title="Bring selected player to the auction block">
                                    📢 Call
                                </button>
                            </div>
                        </form>
                    }

                    <!-- Categorized Visual Queue List -->
                    <div class="queue-items-container" style="max-height: 400px; overflow-y: auto; padding-right: 2px;">
                        @foreach (var group in categorizedPending)
                        {
                            var groupKey = group.Key;
                            var badgeClass = groupKey.Equals("Icon", StringComparison.OrdinalIgnoreCase) ? "bg-warning text-dark border-warning" :
                                             groupKey.Equals("A", StringComparison.OrdinalIgnoreCase) ? "bg-danger-subtle text-danger border-danger-subtle" :
                                             groupKey.Equals("B", StringComparison.OrdinalIgnoreCase) ? "bg-primary-subtle text-primary border-primary-subtle" :
                                             groupKey.Equals("C", StringComparison.OrdinalIgnoreCase) ? "bg-success-subtle text-success border-success-subtle" : "bg-light text-dark border";

                            <div class="queue-category-section mb-2" data-cat="@groupKey.ToLowerInvariant()">
                                <div class="d-flex justify-content-between align-items-center py-1 px-2 mb-1 rounded bg-light border">
                                    <span class="fw-bold small text-uppercase d-flex align-items-center gap-1">
                                        @if (groupKey.Equals("Icon", StringComparison.OrdinalIgnoreCase)) { <span>👑</span> }
                                        <span>@groupKey Category</span>
                                    </span>
                                    <span class="badge @badgeClass" style="font-size: 0.7rem;">@group.Count()</span>
                                </div>

                                <div class="d-flex flex-column gap-1">
                                    @foreach (var lot in group)
                                    {
                                        var lotCat = string.IsNullOrWhiteSpace(lot.Player.Category) ? "unassigned" : lot.Player.Category.Trim().ToLowerInvariant();
                                        <div class="queue-item p-2 border rounded bg-white shadow-sm" data-cat="@lotCat" data-name="@lot.Player.FullName.ToLowerInvariant()" data-role="@lot.Player.Role.ToString().ToLowerInvariant()" data-lot-id="@lot.Id">
                                            <div class="d-flex align-items-center justify-content-between gap-2">
                                                <div class="d-flex align-items-center gap-2 min-w-0">
                                                    <span class="badge bg-light text-dark border flex-shrink-0" style="font-size: 0.72rem;">#@lot.LotNumber</span>
                                                    @if (!string.IsNullOrEmpty(lot.Player.ProfilePictureUrl))
                                                    {
                                                        <img src="@lot.Player.ProfilePictureUrl" alt="@lot.Player.FullName" class="rounded-circle border flex-shrink-0" style="width: 28px; height: 28px; object-fit: cover;" />
                                                    }
                                                    else
                                                    {
                                                        <span class="rounded-circle bg-light border d-inline-flex align-items-center justify-content-center flex-shrink-0" style="width: 28px; height: 28px; font-size: 13px;">👤</span>
                                                    }
                                                    <div class="min-w-0" style="line-height: 1.2;">
                                                        <strong class="text-truncate d-block text-dark small">@lot.Player.FullName</strong>
                                                        <small class="text-muted" style="font-size: 0.72rem;">@lot.Player.Role · ৳@lot.Player.BasePrice.ToString("N0")</small>
                                                    </div>
                                                </div>
                                                @if (User.Identity?.IsAuthenticated == true && Model.Status == AuctionStatus.Live)
                                                {
                                                    <form asp-action="SelectPlayer" asp-route-id="@Model.Id" method="post" class="m-0 flex-shrink-0">
                                                        <input type="hidden" name="lotId" value="@lot.Id" />
                                                        <button type="submit" class="btn btn-outline-primary btn-sm py-0 px-2 fw-bold" style="font-size: 0.75rem;" title="Bring to auction block">
                                                            📢 Call
                                                        </button>
                                                    </form>
                                                }
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        }

                        <div id="noQueueMatches" class="alert alert-light text-center small text-muted py-3 mt-2 d-none">
                            No matching players in queue.
                        </div>
                    </div>
                }
                else
                {
                    <p class="text-muted small mb-0">No remaining pending lots in this auction.</p>
                }
            </div>

            <!-- Bid Audit Trail -->
            <div class="card p-3">
                <h3 class="h6 font-weight-bold text-uppercase text-muted mb-3">Bid History (Current Lot)</h3>
                @if (bids.Any())
                {
                    <div class="table-responsive" style="max-height: 320px; overflow-y: auto;">
                        <table class="table table-sm align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>Team</th>
                                    <th class="text-end">Amount</th>
                                    <th class="text-end">Time</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var bid in bids)
                                {
                                    <tr class="@(bid.IsWinning ? "table-success font-weight-bold" : "")">
                                        <td>
                                            @if (bid.IsWinning) { <span class="text-success me-1">🏆</span> }
                                            @bid.Team.Name
                                        </td>
                                        <td class="text-end">৳@bid.Amount.ToString("N0")</td>
                                        <td class="text-end text-muted small">@bid.PlacedAt.ToLocalTime().ToString("HH:mm:ss")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="text-center py-4 text-muted small">
                        No bids recorded for the active lot yet.
                    </div>
                }
            </div>
        </div>
    </div>
}

@section Scripts {
    <script>
        // Live Search and Category Filter for Lot Queue
        (function () {
            function initQueueFilter() {
                var searchInput = document.getElementById('queueLiveSearchInput');
                var clearBtn = document.getElementById('btnQueueSearchClear');
                var catButtons = document.querySelectorAll('.queue-cat-filter');
                var sections = document.querySelectorAll('.queue-category-section');
                var items = document.querySelectorAll('.queue-item');
                var optgroups = document.querySelectorAll('.queue-optgroup');
                var noMatchesMsg = document.getElementById('noQueueMatches');

                var currentCat = 'ALL';
                var currentTerm = '';

                function filterQueue() {
                    var visibleTotal = 0;

                    // Filter visual queue list
                    sections.forEach(function (sec) {
                        var secCat = (sec.getAttribute('data-cat') || '').toLowerCase();
                        var secItems = sec.querySelectorAll('.queue-item');
                        var visibleInSec = 0;

                        secItems.forEach(function (item) {
                            var itemCat = (item.getAttribute('data-cat') || '').toLowerCase();
                            var itemName = (item.getAttribute('data-name') || '').toLowerCase();
                            var itemRole = (item.getAttribute('data-role') || '').toLowerCase();

                            var matchCat = (currentCat === 'ALL' || itemCat === currentCat.toLowerCase());
                            var matchTerm = (currentTerm === '' || 
                                             itemName.indexOf(currentTerm) !== -1 || 
                                             itemRole.indexOf(currentTerm) !== -1 || 
                                             itemCat.indexOf(currentTerm) !== -1);

                            if (matchCat && matchTerm) {
                                item.style.display = '';
                                visibleInSec++;
                                visibleTotal++;
                            } else {
                                item.style.display = 'none';
                            }
                        });

                        sec.style.display = visibleInSec > 0 ? '' : 'none';
                    });

                    // Filter dropdown optgroups and options if present
                    optgroups.forEach(function (og) {
                        var ogCat = (og.getAttribute('data-cat') || '').toLowerCase();
                        var ogOptions = og.querySelectorAll('.queue-option');
                        var visibleInOg = 0;

                        ogOptions.forEach(function (opt) {
                            var optCat = (opt.getAttribute('data-cat') || '').toLowerCase();
                            var optName = (opt.getAttribute('data-name') || '').toLowerCase();
                            var optRole = (opt.getAttribute('data-role') || '').toLowerCase();

                            var matchCat = (currentCat === 'ALL' || optCat === currentCat.toLowerCase());
                            var matchTerm = (currentTerm === '' || 
                                             optName.indexOf(currentTerm) !== -1 || 
                                             optRole.indexOf(currentTerm) !== -1 || 
                                             optCat.indexOf(currentTerm) !== -1);

                            if (matchCat && matchTerm) {
                                opt.style.display = '';
                                visibleInOg++;
                            } else {
                                opt.style.display = 'none';
                            }
                        });

                        og.style.display = visibleInOg > 0 ? '' : 'none';
                    });

                    if (noMatchesMsg) {
                        noMatchesMsg.classList.toggle('d-none', visibleTotal > 0);
                    }
                    if (clearBtn) {
                        clearBtn.style.display = currentTerm ? '' : 'none';
                    }
                }

                if (searchInput) {
                    searchInput.addEventListener('input', function () {
                        currentTerm = this.value.trim().toLowerCase();
                        filterQueue();
                    });
                }

                if (clearBtn) {
                    clearBtn.addEventListener('click', function () {
                        searchInput.value = '';
                        currentTerm = '';
                        filterQueue();
                        searchInput.focus();
                    });
                }

                catButtons.forEach(function (btn) {
                    btn.addEventListener('click', function () {
                        catButtons.forEach(b => {
                            b.classList.remove('btn-dark', 'active');
                            b.classList.add('btn-outline-secondary');
                        });
                        this.classList.remove('btn-outline-secondary');
                        this.classList.add('btn-dark', 'active');
                        currentCat = this.getAttribute('data-cat') || 'ALL';
                        filterQueue();
                    });
                });
            }

            if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', initQueueFilter);
            } else {
                initQueueFilter();
            }
        })();
    </script>
}
