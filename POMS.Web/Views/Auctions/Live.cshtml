@model Auction?
@{
    ViewData["Title"] = Model?.Name ?? "Live Auction Console";
    var teams = (IEnumerable<Team>)(ViewBag.Teams ?? Array.Empty<Team>());
    var pending = (IEnumerable<AuctionPlayer>)(ViewBag.PendingLots ?? Array.Empty<AuctionPlayer>());
    var bids = (IEnumerable<Bid>)(ViewBag.Bids ?? Array.Empty<Bid>());
    var current = Model?.CurrentAuctionPlayer;
    var highest = bids.FirstOrDefault();
    var minBidAmount = (highest?.Amount ?? current?.Player.BasePrice ?? 0) + (Model?.MinimumIncrement ?? 5000);
}

@if (Model is null)
{
    <div class="empty-state py-5 my-4 text-center">
        <div class="display-1 mb-3">📣</div>
        <span class="eyebrow">Operator Workspace</span>
        <h1 class="h2 font-weight-bold">No Live Auction Active</h1>
        <p class="text-muted lead max-w-md mx-auto">
            Create an auction event, populate the player lot list, and launch the live room.
        </p>
        <div class="d-flex justify-content-center gap-3 mt-4">
            <a class="btn btn-primary btn-lg" asp-action="Create">Create Auction</a>
            <a class="btn btn-outline-secondary btn-lg" asp-action="Index">Browse All Auctions</a>
        </div>
    </div>
}
else
{
    var statusClass = Model.Status == AuctionStatus.Paused ? "status-paused" : Model.Status == AuctionStatus.Live ? "status-live" : "status-draft";
    
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="status-pill @statusClass">
                    @if (Model.Status == AuctionStatus.Live) { <i class="live-dot animate-pulse"></i> }
                    @Model.Status
                </span>
                <span class="text-muted small">Min Increment: ৳@Model.MinimumIncrement.ToString("N0")</span>
            </div>
            <h1 class="h2 font-weight-bold mb-0">@Model.Name</h1>
        </div>
        
        <div class="d-flex align-items-center gap-2">
            @if (User.Identity?.IsAuthenticated == true)
            {
                if (Model.Status == AuctionStatus.Live)
                {
                    <form asp-action="Status" asp-route-id="@Model.Id" method="post" class="d-inline">
                        <input type="hidden" name="status" value="Paused" />
                        <button class="btn btn-outline-warning btn-sm fw-bold">⏸️ Pause Bidding</button>
                    </form>
                }
                else if (Model.Status == AuctionStatus.Paused)
                {
                    <form asp-action="Status" asp-route-id="@Model.Id" method="post" class="d-inline">
                        <input type="hidden" name="status" value="Live" />
                        <button class="btn btn-success btn-sm fw-bold">▶️ Resume Bidding</button>
                    </form>
                }
                <a class="btn btn-outline-secondary btn-sm" asp-action="Details" asp-route-id="@Model.Id">Settings & Lots</a>
            }
            <button class="btn btn-light btn-sm border" onclick="location.reload()" title="Refresh live status">
                🔄 Refresh
            </button>
        </div>
    </div>

    @if (TempData["Success"] is string success)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            ✓ @success
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["Error"] is string error)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            ⚠️ @error
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row g-4">
        <!-- Main Stage Column -->
        <div class="col-xl-8">
            <!-- Stage Centerpiece -->
            <div class="lot-stage text-center">
                <span class="stage-kicker">NOW ON THE BLOCK</span>
                @if (current is null)
                {
                    <div class="py-5">
                        <div class="display-4 mb-2">⏳</div>
                        <h3 class="text-white-50">Waiting for Next Lot Selection</h3>
                        <p class="text-muted">Select a pending lot from the queue to start bidding.</p>
                    </div>
                }
                else
                {
                    <h2 class="stage-player">@current.Player.FullName</h2>
                    <div class="d-flex justify-content-center flex-wrap gap-2 mb-3">
                        <span class="badge bg-primary px-3 py-2">@current.Player.Role</span>
                        <span class="badge bg-secondary px-3 py-2">Rating: @current.Player.SkillRating/100</span>
                        @if (!string.IsNullOrEmpty(current.Player.Nationality))
                        {
                            <span class="badge bg-dark px-3 py-2">🌐 @current.Player.Nationality</span>
                        }
                    </div>
                    <p class="text-light mb-4">
                        Base Price: <strong class="text-warning">৳@current.Player.BasePrice.ToString("N0")</strong>
                        @if (!string.IsNullOrEmpty(current.Player.BattingStyle)) { <span> · @current.Player.BattingStyle Bat</span> }
                        @if (!string.IsNullOrEmpty(current.Player.BowlingStyle)) { <span> · @current.Player.BowlingStyle</span> }
                    </p>

                    <div class="highest-bid-box">
                        <span class="text-uppercase small font-weight-bold text-light opacity-75">Highest Bid</span>
                        <div class="highest-bid-amount">
                            ৳@(highest?.Amount.ToString("N0") ?? current.Player.BasePrice.ToString("N0"))
                        </div>
                        <small class="text-light font-weight-bold">
                            @(highest is not null ? $"Held by {highest.Team.Name}" : "Opening Lot Price")
                        </small>
                    </div>
                }
            </div>

            <!-- Bidding Actions (Only if authenticated operator & auction is Live) -->
            @if (current is not null && Model.Status == AuctionStatus.Live)
            {
                if (User.Identity?.IsAuthenticated == true)
                {
                    <div class="card p-4 mt-4">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h3 class="h5 mb-0 font-weight-bold">💰 Place Bid</h3>
                            <span class="badge bg-light text-dark border">
                                Minimum Next Bid: <strong>৳@minBidAmount.ToString("N0")</strong>
                            </span>
                        </div>

                        <!-- Quick Increment Buttons -->
                        <div class="d-flex flex-wrap gap-2 mb-3">
                            <span class="small align-self-center text-muted me-1">Quick Add:</span>
                            <button type="button" class="btn btn-sm btn-outline-secondary quick-bid-btn" onclick="setBidAmount(@minBidAmount)">
                                Min Bid (৳@minBidAmount.ToString("N0"))
                            </button>
                            <button type="button" class="btn btn-sm btn-outline-primary quick-bid-btn" onclick="addBidIncrement(50000)">
                                + ৳50,000
                            </button>
                            <button type="button" class="btn btn-sm btn-outline-primary quick-bid-btn" onclick="addBidIncrement(100000)">
                                + ৳100,000
                            </button>
                            <button type="button" class="btn btn-sm btn-outline-primary quick-bid-btn" onclick="addBidIncrement(500000)">
                                + ৳500,000
                            </button>
                        </div>

                        <form asp-action="PlaceBid" asp-route-id="@Model.Id" method="post" id="bidForm">
                            <input type="hidden" name="lotId" value="@current.Id" />
                            <div class="row g-3 align-items-end">
                                <div class="col-lg-6">
                                    <label class="form-label font-weight-bold">Bidding Team</label>
                                    <select name="teamId" class="form-select form-select-lg" required>
                                        <option value="">-- Select Team --</option>
                                        @foreach (var team in teams)
                                        {
                                            <option value="@team.Id">@team.Name (Purse: ৳@team.TotalBudget.ToString("N0"))</option>
                                        }
                                    </select>
                                </div>
                                <div class="col-lg-4">
                                    <label class="form-label font-weight-bold">Bid Amount (৳)</label>
                                    <input name="amount" id="bidAmountInput" type="number" step="1" min="@minBidAmount" value="@minBidAmount" class="form-control form-control-lg" required />
                                </div>
                                <div class="col-lg-2">
                                    <button class="btn btn-primary btn-lg w-100 font-weight-bold" type="submit">Bid Now</button>
                                </div>
                            </div>
                        </form>

                        <hr class="my-4" />

                        <!-- Lot Conclusion Actions -->
                        <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
                            <span class="text-muted small">Conclude this lot:</span>
                            <div class="d-flex gap-2">
                                <form asp-action="FinishPlayer" asp-route-id="@Model.Id" method="post">
                                    <input type="hidden" name="sold" value="true" />
                                    <button class="btn btn-success font-weight-bold px-4" type="submit" @(highest is null ? "disabled title='Requires a bid to sell'" : "")>
                                        🔨 Sell Player to @(highest?.Team.Name ?? "Highest Bidder")
                                    </button>
                                </form>
                                <form asp-action="FinishPlayer" asp-route-id="@Model.Id" method="post">
                                    <input type="hidden" name="sold" value="false" />
                                    <button class="btn btn-outline-danger font-weight-bold px-3" type="submit">
                                        ❌ Mark Unsold
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    <div class="alert alert-info mt-4 d-flex align-items-center gap-3">
                        <span class="fs-3">🔒</span>
                        <div>
                            <strong>Spectator Mode</strong>
                            <p class="mb-0 small">You are viewing the live auction. <a asp-controller="Account" asp-action="Login" asp-route-returnUrl="@Context.Request.Path" class="fw-bold">Sign in as operator</a> to place bids.</p>
                        </div>
                    </div>
                }
            }
        </div>

        <!-- Sidebar Column (Lot Queue & Bidding Audit Trail) -->
        <div class="col-xl-4">
            <!-- Next Player Queue -->
            <div class="card p-3 mb-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h3 class="h6 font-weight-bold text-uppercase text-muted mb-0">Lot Queue</h3>
                    <span class="badge bg-primary rounded-pill">@pending.Count() Pending</span>
                </div>
                @if (pending.Any())
                {
                    if (User.Identity?.IsAuthenticated == true && Model.Status == AuctionStatus.Live)
                    {
                        <form asp-action="SelectPlayer" asp-route-id="@Model.Id" method="post">
                            <div class="mb-2">
                                <select name="lotId" class="form-select" required>
                                    <option value="">-- Select Next Player --</option>
                                    @foreach (var lot in pending)
                                    {
                                        <option value="@lot.Id">
                                            #@lot.LotNumber · @lot.Player.FullName (@lot.Player.Role) - ৳@lot.Player.BasePrice.ToString("N0")
                                        </option>
                                    }
                                </select>
                            </div>
                            <button class="btn btn-outline-primary btn-sm w-100 font-weight-bold" type="submit">
                                📢 Bring Player to Block
                            </button>
                        </form>
                    }
                    else
                    {
                        <ul class="list-group list-group-flush small">
                            @foreach (var lot in pending.Take(5))
                            {
                                <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                                    <span>#@lot.LotNumber · <strong>@lot.Player.FullName</strong></span>
                                    <span class="badge bg-light text-dark">৳@lot.Player.BasePrice.ToString("N0")</span>
                                </li>
                            }
                        </ul>
                    }
                }
                else
                {
                    <p class="text-muted small mb-0">No remaining pending lots in this auction.</p>
                }
            </div>

            <!-- Bid Audit Trail -->
            <div class="card p-3">
                <h3 class="h6 font-weight-bold text-uppercase text-muted mb-3">Bid History (Current Lot)</h3>
                @if (bids.Any())
                {
                    <div class="table-responsive" style="max-height: 320px; overflow-y: auto;">
                        <table class="table table-sm align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>Team</th>
                                    <th class="text-end">Amount</th>
                                    <th class="text-end">Time</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var bid in bids)
                                {
                                    <tr class="@(bid.IsWinning ? "table-success font-weight-bold" : "")">
                                        <td>
                                            @if (bid.IsWinning) { <span class="text-success me-1">🏆</span> }
                                            @bid.Team.Name
                                        </td>
                                        <td class="text-end">৳@bid.Amount.ToString("N0")</td>
                                        <td class="text-end text-muted small">@bid.PlacedAt.ToLocalTime().ToString("HH:mm:ss")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="text-center py-4 text-muted small">
                        No bids recorded for the active lot yet.
                    </div>
                }
            </div>
        </div>
    </div>
}

@section Scripts {
    <script>
        function setBidAmount(amount) {
            document.getElementById('bidAmountInput').value = amount;
        }

        function addBidIncrement(increment) {
            const input = document.getElementById('bidAmountInput');
            const currentVal = parseFloat(input.value) || 0;
            input.value = currentVal + increment;
        }

        // Auto-refresh live status every 10 seconds if auction is Live
        @if (Model?.Status == AuctionStatus.Live && current is not null)
        {
            <text>
            setInterval(function () {
                // Only refresh if user is not actively typing in an input field
                if (document.activeElement.tagName !== 'INPUT' && document.activeElement.tagName !== 'SELECT') {
                    location.reload();
                }
            }, 10000);
            </text>
        }
    </script>
}
