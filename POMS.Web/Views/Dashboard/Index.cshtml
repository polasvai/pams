@{
    ViewData["Title"] = "Dashboard";
}
<div class="page-heading d-flex flex-wrap justify-content-between align-items-end gap-3"><div><span class="eyebrow">Command center</span><h1 class="h3 mb-1">Auction dashboard</h1><p class="text-muted mb-0">A clear view of your auction operation.</p></div><div class="d-flex gap-2"><a class="btn btn-outline-secondary" asp-controller="Auctions" asp-action="Index">Manage auctions</a><a class="btn btn-primary" asp-controller="Auctions" asp-action="Live">Open live console</a></div></div>
@if (TempData["Success"] is string success) { <div class="alert alert-success alert-soft">@success</div> }
<div class="row g-3 mb-4"><div class="col-sm-6 col-xl-3"><div class="stat-card"><div class="stat-icon green">♙</div><div><span>Active players</span><strong>@ViewBag.PlayerCount</strong><small>Ready for the lot list</small></div></div></div><div class="col-sm-6 col-xl-3"><div class="stat-card"><div class="stat-icon blue">▦</div><div><span>Registered teams</span><strong>@ViewBag.TeamCount</strong><small>Active auction purses</small></div></div></div><div class="col-sm-6 col-xl-3"><div class="stat-card"><div class="stat-icon amber">◈</div><div><span>Auctions hosted</span><strong>@ViewBag.AuctionCount</strong><small>Across all seasons</small></div></div></div><div class="col-sm-6 col-xl-3"><div class="stat-card"><div class="stat-icon purple">₹</div><div><span>Total team budget</span><strong>₹@ViewBag.TotalBudgetText</strong><small>Available across teams</small></div></div></div></div>
<div class="row g-4"><div class="col-xl-8"><section class="dashboard-card"><div class="card-heading"><div><span class="eyebrow">Live now</span><h2 class="h5 mb-0">Auction status</h2></div><a class="btn btn-sm btn-primary" asp-controller="Auctions" asp-action="Live">Open console</a></div>@if (ViewBag.ActiveAuction is Auction active) { <div class="active-auction"><div class="live-indicator"><i></i> @active.Status</div><h3>@active.Name</h3><p>Minimum increment: ₹@active.MinimumIncrement.ToString("N0") · Current lot: @(active.CurrentAuctionPlayer?.Player?.FullName ?? "Waiting for selection")</p><a class="btn btn-warning" asp-controller="Auctions" asp-action="Live" asp-route-id="@active.Id">Continue auction</a></div> } else { <div class="empty-state"><strong>No auction is live</strong><span>Create a draft, add players, and start the room when you are ready.</span><br /><a class="btn btn-primary" asp-controller="Auctions" asp-action="Create">Create auction</a></div> }</section></div><div class="col-xl-4"><section class="dashboard-card"><div class="card-heading"><div><span class="eyebrow">Quick actions</span><h2 class="h5 mb-0">Shortcuts</h2></div></div><div class="quick-actions"><a asp-controller="Players" asp-action="Index"><span>♙</span><div><strong>Player pool</strong><small>Review active talent</small></div><b>→</b></a><a asp-controller="Teams" asp-action="Index"><span>▦</span><div><strong>Team directory</strong><small>View purses and squads</small></div><b>→</b></a><a asp-controller="Auctions" asp-action="Create"><span>＋</span><div><strong>New auction</strong><small>Start a new draft</small></div><b>→</b></a></div></section></div></div>
<section class="dashboard-card mt-4"><div class="card-heading"><div><span class="eyebrow">Activity</span><h2 class="h5 mb-0">Recent auctions</h2></div><a class="text-link" asp-controller="Auctions" asp-action="Index">View all →</a></div>@if (ViewBag.RecentAuctions is IEnumerable<Auction> recent && recent.Any()) { <div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>Auction</th><th>Status</th><th>Lots</th><th>Started</th><th></th></tr></thead><tbody>@foreach (var auction in recent) { <tr><td class="fw-semibold">@auction.Name</td><td><span class="auction-status @auction.Status.ToString().ToLowerInvariant()">@auction.Status</span></td><td>@auction.AuctionPlayers.Count</td><td>@(auction.StartsAt == default ? "Not started" : auction.StartsAt.ToString("g"))</td><td class="text-end"><a class="btn btn-sm btn-outline-primary" asp-controller="Auctions" asp-action="Details" asp-route-id="@auction.Id">Open</a></td></tr> }</tbody></table></div> } else { <div class="empty-state"><strong>No auction history yet</strong><span>Your configured auctions will appear here.</span></div> }</section>
