@{
    ViewData["Title"] = "Auction Dashboard";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <span class="eyebrow">Command Center</span>
        <h1 class="h2 font-weight-bold mb-0">Auction Operations Dashboard</h1>
    </div>
    <div class="d-flex gap-2">
        <a class="btn btn-outline-secondary" asp-controller="Auctions" asp-action="Index">Auctions Directory</a>
        <a class="btn btn-warning font-weight-bold" asp-controller="Auctions" asp-action="Live">Open Live Console ↗</a>
    </div>
</div>

@if (TempData["Success"] is string success)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        ✓ @success
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Key Metric Cards -->
<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-3">
        <div class="stat-card">
            <div class="stat-icon purple">🏏</div>
            <div>
                <span class="text-muted small">Active Players</span>
                <div class="h3 font-weight-bold mb-0">@ViewBag.PlayerCount</div>
                <small class="text-muted">Available in pool</small>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="stat-card">
            <div class="stat-icon blue">🛡️</div>
            <div>
                <span class="text-muted small">Registered Teams</span>
                <div class="h3 font-weight-bold mb-0">@ViewBag.TeamCount</div>
                <small class="text-muted">Active franchises</small>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="stat-card">
            <div class="stat-icon amber">📋</div>
            <div>
                <span class="text-muted small">Auctions Hosted</span>
                <div class="h3 font-weight-bold mb-0">@ViewBag.AuctionCount</div>
                <small class="text-muted">Events configured</small>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="stat-card">
            <div class="stat-icon green">💰</div>
            <div>
                <span class="text-muted small">Total Team Budget</span>
                <div class="h4 font-weight-bold mb-0">₹@ViewBag.TotalBudgetText</div>
                <small class="text-muted">Combined purses</small>
            </div>
        </div>
    </div>
</div>

<div class="row g-4">
    <!-- Active Auction Status -->
    <div class="col-xl-8">
        <div class="card p-4">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <div>
                    <span class="eyebrow">Current Status</span>
                    <h2 class="h5 font-weight-bold mb-0">Live Auction Event</h2>
                </div>
                <a class="btn btn-sm btn-primary" asp-controller="Auctions" asp-action="Live">Open Console</a>
            </div>

            @if (ViewBag.ActiveAuction is Auction active)
            {
                <div class="p-4 rounded border bg-light">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="status-pill @(active.Status == AuctionStatus.Live ? "status-live" : "status-paused")">
                            @if (active.Status == AuctionStatus.Live) { <i class="live-dot animate-pulse"></i> }
                            @active.Status
                        </span>
                        <small class="text-muted">Min Increment: ₹@active.MinimumIncrement.ToString("N0")</small>
                    </div>
                    <h3 class="h4 font-weight-bold text-dark mb-2">@active.Name</h3>
                    <p class="text-muted mb-3">
                        Active Lot: <strong>@(active.CurrentAuctionPlayer?.Player?.FullName ?? "Waiting for lot selection")</strong>
                    </p>
                    <a class="btn btn-warning font-weight-bold" asp-controller="Auctions" asp-action="Live" asp-route-id="@active.Id">
                        Join Live Auction Room ↗
                    </a>
                </div>
            }
            else
            {
                <div class="text-center py-5 text-muted border border-dashed rounded">
                    <div class="display-6 mb-2">📋</div>
                    <strong class="d-block text-dark mb-1">No Active Live Auction</strong>
                    <p class="small mb-3">Create a draft auction, assign players, and launch when ready.</p>
                    <a class="btn btn-primary btn-sm" asp-controller="Auctions" asp-action="Create">Create New Auction</a>
                </div>
            }
        </div>
    </div>

    <!-- Shortcuts -->
    <div class="col-xl-4">
        <div class="card p-4">
            <span class="eyebrow">Management</span>
            <h2 class="h5 font-weight-bold mb-3">Quick Actions</h2>

            <div class="d-grid gap-2">
                <a class="btn btn-outline-primary text-start p-3 d-flex justify-content-between align-items-center" asp-controller="Players" asp-action="Create">
                    <div>
                        <strong class="d-block">🏏 Add New Player</strong>
                        <small class="text-muted">Add to talent pool</small>
                    </div>
                    <span>→</span>
                </a>
                <a class="btn btn-outline-primary text-start p-3 d-flex justify-content-between align-items-center" asp-controller="Teams" asp-action="Create">
                    <div>
                        <strong class="d-block">🛡️ Add Franchise Team</strong>
                        <small class="text-muted">Set purse & name</small>
                    </div>
                    <span>→</span>
                </a>
                <a class="btn btn-outline-primary text-start p-3 d-flex justify-content-between align-items-center" asp-controller="Auctions" asp-action="Create">
                    <div>
                        <strong class="d-block">➕ Create Draft Auction</strong>
                        <small class="text-muted">Configure lots & rules</small>
                    </div>
                    <span>→</span>
                </a>
            </div>
        </div>
    </div>
</div>

<!-- Recent Auctions Table -->
<div class="card p-4 mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <span class="eyebrow">History</span>
            <h2 class="h5 font-weight-bold mb-0">Recent Auctions</h2>
        </div>
        <a class="btn btn-sm btn-outline-secondary" asp-controller="Auctions" asp-action="Index">View All</a>
    </div>

    @if (ViewBag.RecentAuctions is IEnumerable<Auction> recent && recent.Any())
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>Auction Name</th>
                        <th>Status</th>
                        <th>Lots</th>
                        <th>Start Time</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var auction in recent)
                    {
                        <tr>
                            <td class="font-weight-bold">@auction.Name</td>
                            <td>
                                <span class="badge @(auction.Status == AuctionStatus.Live ? "bg-success" : auction.Status == AuctionStatus.Paused ? "bg-warning text-dark" : "bg-secondary")">
                                    @auction.Status
                                </span>
                            </td>
                            <td>@auction.AuctionPlayers.Count lot(s)</td>
                            <td class="text-muted small">
                                @(auction.StartsAt == default ? "Not started" : auction.StartsAt.ToLocalTime().ToString("g"))
                            </td>
                            <td class="text-end">
                                <a class="btn btn-sm btn-outline-primary" asp-controller="Auctions" asp-action="Details" asp-route-id="@auction.Id">Open Details</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <p class="text-muted mb-0 text-center py-4">No auction events recorded yet.</p>
    }
</div>
